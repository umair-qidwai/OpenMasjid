{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["tools/**/*.ts", "packages/core/src/**/*.ts", "tests/core/**/*.ts", "tests/web/**/*.ts"],
  "exclude": ["node_modules", "apps/web/.astro", "apps/web/dist"]
}
