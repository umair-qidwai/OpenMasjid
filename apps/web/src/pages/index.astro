---
import Base from '../layouts/Base.astro';
import site from '../lib/site.json';
import { getNextPrayer, localDate, localTime, resolveCampusId, campusEvents, campusAnnouncements, resolveAssetUrl } from '../lib/site';
const campusId = resolveCampusId(site);
const campus = site.campuses.find((item) => item.id === campusId)!;
const today = localDate(campus.timezone);
const row = campus.timetable.find((item) => item.date === today) ?? campus.timetable[0];
const next = row ? getNextPrayer(row, localTime(campus.timezone)) : null;
const events = campusEvents(site, campusId).slice(0, 3);
const announcements = campusAnnouncements(site, campusId).slice(0, 3);
const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
const prayerKeys = ['fajr','sunrise','dhuhr','asr','maghrib','isha'] as const;
const offeringSections = [
  { id: 'programs', title: 'Programs', description: 'Learn, grow, and build lasting connections through gatherings for every stage of life.', items: site.programs },
  { id: 'services', title: 'Services', description: 'Practical, spiritual, and community support when you need it.', items: site.services },
];
---
<Base title={`${site.organization.name} · ${campus.name}`} description={site.organization.tagline} icon={logoUrl}>
  <link rel="stylesheet" href={`${basePath}assets/fonts/fonts.css`} />
  <header class="container site-header" id="site-header">
    <a class="brand" href={basePath} aria-label={site.organization.name}><img src={logoUrl} data-site-logo alt="" /><span class="brand-name">{site.organization.name}</span></a>
    <nav class="nav" aria-label="Primary"><a href="#prayer" data-nav-target="prayer">Prayer</a><a href="#programs" data-nav-target="programs">Programs</a><a href="#services" data-nav-target="services">Services</a><a href="#community" data-nav-target="community">Community</a><a href="#locations" data-nav-target="locations">Locations</a></nav>
    <a class="button header-action" href={`${basePath}donate/`}>Donate <span aria-hidden="true">↗</span></a>
  </header>

  <dialog id="campus-dialog" aria-labelledby="campus-dialog-title" aria-describedby="campus-dialog-description">
    <button type="button" class="dialog-close" id="campus-dialog-close" aria-label="Decide later">×</button>
    <h2 id="campus-dialog-title">Choose your location</h2>
    <p id="campus-dialog-description">We’ll personalize prayer times, events, and community updates. Your choice is remembered on this device.</p>
    <div class="campus-dialog-options" id="campus-dialog-options" role="radiogroup" aria-label="Locations"></div>
    <button type="button" class="button campus-dialog-continue" id="campus-dialog-continue" disabled>Choose a location</button>
  </dialog>

  <main style={`--pattern:url("${basePath}assets/mosque-pattern.svg")`}>
    <section class="container hero" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <h1 id="hero-title">Rooted in faith.<br />Open to all.</h1>
        <p class="hero-tagline" aria-label="A place to belong, worship, grow, and gather.">A place to <span aria-hidden="true" class="type-line" data-words='["belong.","worship.","grow.","gather."]'>belong.</span></p>
        <p>{site.organization.description}</p>
        <div class="hero-actions"><a class="button" href="#prayer">View prayer times <span aria-hidden="true">↓</span></a><a class="text-link" href="#programs">Explore our community <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-art reveal" style="--delay:120ms" aria-hidden="true">
        <div class="sun"></div><div class="arch-window"><img src={logoUrl} data-site-logo alt="" /></div>
        <div class="hero-note"><span>السلام عليكم</span><small>Peace be upon you</small></div>
      </div>
    </section>

    <section class="prayer-wrap" id="prayer" aria-labelledby="prayer-title">
      <div class="container">
        <div class="section-head light reveal"><div><h2 id="prayer-title">Prayer times</h2></div></div>
        <div class="prayer-panel reveal" id="prayer-panel">
          <div class="prayer-lead"><div class="prayer-meta"><span id="campus-name">{campus.name}</span><span id="today">{today}</span></div><p>Next prayer</p><strong class="next-name" id="next-name">{next ? next.key[0].toUpperCase() + next.key.slice(1) : 'Schedule'}</strong><div class="next-row"><b id="next-time">{next?.time ?? '—'}</b><span id="next-iqamah">{next ? `Iqamah ${row?.iqamah?.[next.key] ?? campus.iqamah[next.key]}` : ''}</span></div></div>
          <div class="schedule" id="schedule">{prayerKeys.map((key) => <div><small>{key}</small><b data-prayer={key}>{row?.[key] ?? '—'}</b>{key !== 'sunrise' && <span data-iqamah={key}>Iqamah {row?.iqamah?.[key] ?? campus.iqamah[key]}</span>}</div>)}</div>
          <div id="jumuah" class="jumuah"><strong>Jumuah</strong>{campus.jumuah.map((gathering) => <span>{gathering.label} · {gathering.time}</span>)}</div>
        </div>
        <p class="prayer-disclaimer">Times are for the selected campus. Confirm locally for special days and schedule changes.</p>
      </div>
    </section>

    {offeringSections.map((section, sectionIndex) => <section class:list={['container','section','offering-section',`${section.id}-section`]} id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-head reveal"><div><h2 id={`${section.id}-title`}>{section.title}</h2></div><p class="muted">{section.description}</p></div>
      <div class="service-grid">{section.items.map((item, index) => <article class="service-card reveal" style={`--delay:${index * 90}ms`} data-campus-ids={item.campusIds.join(',')} hidden={item.campusIds.length > 0 && !item.campusIds.includes(campusId)}>
        <span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          {sectionIndex === 0 ? (index % 2 === 0 ? <><path d="M12 6C9 3 5 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-3-1-7-1-10 2Z"/><path d="M12 6v15"/></> : <><circle cx="12" cy="8" r="3"/><path d="M5 21c.7-5 3-7 7-7s6.3 2 7 7"/></>) : (index % 2 === 0 ? <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></> : <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>)}
        </svg></span>
        <h3>{item.title}</h3><p>{item.description}</p>
        {item.details.enabled && <a class="button service-action" href={`${basePath}${section.id}/${item.id}/`}>More information <span aria-hidden="true">→</span></a>}
      </article>)}</div>
    </section>)}

    <section class="community-section" id="community">
      <div class="container">
        <div class="section-head reveal"><div><h2>Gather. Learn. Connect.</h2></div><div class="community-filters" role="group" aria-label="Filter community content"><button type="button" class="filter active" data-filter="all">All</button><button type="button" class="filter" data-filter="announcement">Announcements</button><button type="button" class="filter" data-filter="event">Events</button></div></div>
        <div id="community-cards" class="community-grid">
          <section class="events-column" data-section-kind="event" aria-labelledby="events-title"><div class="column-title"><h2 id="events-title">Upcoming events</h2></div><div id="event-cards">{events.map((item) => <article class="event-card reveal" data-kind="event"><time datetime={item.startsAt}><b>{new Date(item.startsAt).toLocaleDateString(undefined,{day:'2-digit'})}</b><span>{new Date(item.startsAt).toLocaleDateString(undefined,{month:'short'})}</span></time><div><span class="card-label">{item.category}</span><h3>{item.title}</h3><p>{item.description}</p><small>{item.location}</small></div></article>)}</div></section>
          <section class="news-column" data-section-kind="announcement" aria-labelledby="announcements-title"><div class="column-title"><h2 id="announcements-title">Announcements</h2></div><div id="announcement-cards">{announcements.map((item) => <article class="news-card reveal" data-kind="announcement"><span class="card-label">Community note</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
        </div>
      </div>
    </section>

    <section class="give-section"><div class="container give-card reveal"><div><h2>Your generosity makes room for everyone.</h2></div><div><p>Support prayer, learning, care, and connection across our community.</p><a class="button gold" href={`${basePath}donate/`}>Make a donation <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="container section visit" id="locations" aria-labelledby="locations-title">
      <div class="visit-copy reveal"><h2 id="locations-title">Locations</h2><p>Choose your location, get directions, or contact its team directly.</p></div>
      <div class="campus-locations" id="campus-locations">{site.campuses.map((item) => <article class="location-card reveal" data-campus-id={item.id} data-selected={item.id === campusId ? 'true' : 'false'}>
        <span class="campus-selection">{item.id === campusId ? 'Current location' : 'Location'}</span><h3>{item.name}</h3><p>{item.address}<br />{item.city}</p>
        <div class="contact-actions"><a href={`mailto:${item.email}`}>Email <span class="sr-only">{item.name}</span></a><a href={`tel:${item.phone}`}>Call <span class="sr-only">{item.name}</span></a><a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${item.address}, ${item.city}`)}`} target="_blank" rel="noopener noreferrer">Directions <span class="sr-only">to {item.name} (opens a new tab)</span> ↗</a></div>
        <div class="facility-list">{item.facilities.map((facility) => <span>{facility}</span>)}</div>
        {item.id !== campusId && <button type="button" class="button secondary location-select" data-select-campus={item.id}>Use {item.name}</button>}
      </article>)}</div>
    </section>
  </main>

  <footer class="footer"><div class="container site-footer"><div><div class="footer-brand"><span class="footer-logo"><img src={logoUrl} data-site-logo alt="" /></span><span>{site.organization.name}</span></div><p>A welcoming digital doorway for prayer, service, and belonging.</p></div><div class="footer-links"><a href="#prayer">Prayer times</a><a href="#programs">Programs</a><a href="#services">Services</a><a href="#community">Community</a><a href="#locations">Locations</a></div><div class="footer-meta"><a href={`mailto:${site.organization.email}`}>{site.organization.email}</a><span>© {new Date().getFullYear()} {site.organization.name}</span></div></div></footer>
</Base>

<style is:global>
.hero{min-height:760px;padding:clamp(5rem,10vw,9rem) 0 7rem;display:grid;grid-template-columns:1.06fr .94fr;align-items:center;gap:clamp(2rem,6vw,6rem)}.hero-copy{position:relative;z-index:1}.hero h1{margin:.6rem 0 1.8rem;color:var(--green);max-width:760px}.type-line{display:inline-block;color:var(--gold);min-width:5.8em}.type-line.typing:after{content:"";display:inline-block;width:3px;height:.75em;margin-left:.08em;background:currentColor;animation:blink .8s steps(1) infinite}.hero-copy>p{max-width:540px;font-size:1.08rem;color:var(--muted)}.hero-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}.text-link{min-height:44px;display:inline-flex;align-items:center;gap:.5rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}.hero-art{position:relative;min-height:570px}.arch-window{position:absolute;inset:0 0 0 14%;display:grid;place-items:center;border-radius:260px 260px 22px 22px;background:var(--green);overflow:hidden;box-shadow:var(--shadow)}.arch-window:before,.arch-window:after{content:"";position:absolute;border:1px solid rgba(224,193,128,.34);border-radius:50%}.arch-window:before{width:430px;height:430px}.arch-window:after{width:300px;height:300px}.arch-window img{position:relative;z-index:1;width:38%;opacity:.92}.sun{position:absolute;z-index:-1;width:190px;height:190px;right:-12%;top:2%;border-radius:50%;background:var(--gold)}.hero-note{position:absolute;z-index:2;left:0;bottom:8%;display:grid;padding:1.1rem 1.4rem;border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.hero-note span{font-family:Georgia,serif;font-size:1.8rem;color:var(--green)}.hero-note small{color:var(--muted)}
.prayer-wrap{padding:clamp(4.5rem,8vw,7rem) 0;background:var(--green);color:white}.section-head.light h2{color:white}.section-head.light .eyebrow{color:#e3bd77}.section-head form{display:grid;gap:.3rem;min-width:min(100%,300px)}.section-head label{font-size:.7rem;text-transform:uppercase;letter-spacing:.14em;color:#c7d6d0;font-weight:800}.section-head select{min-height:48px;padding:.6rem 2.5rem .6rem .8rem;border:1px solid rgba(255,255,255,.24);background:#21493f;color:white;border-radius:5px}.prayer-panel{display:grid;grid-template-columns:1.05fr 1.95fr;border-top:1px solid rgba(255,255,255,.2);border-bottom:1px solid rgba(255,255,255,.2)}.prayer-lead{padding:2rem 2rem 2rem 0;border-right:1px solid rgba(255,255,255,.2)}.prayer-meta{display:flex;justify-content:space-between;gap:1rem;color:#bdd0c9;font-size:.82rem}.prayer-lead>p{margin:3.2rem 0 .1rem;color:#bdd0c9}.next-name{font-size:clamp(2.2rem,5vw,4rem);font-family:"Trebuchet MS",sans-serif}.next-row{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-top:1.2rem}.next-row b{font-size:2rem;color:#e3bd77}.next-row span{font-size:.8rem;color:#bdd0c9}.schedule{display:grid;grid-template-columns:repeat(3,1fr)}.schedule>div{display:grid;align-content:center;gap:.4rem;padding:1.35rem;border-right:1px solid rgba(255,255,255,.13);border-bottom:1px solid rgba(255,255,255,.13)}.schedule small{text-transform:capitalize;color:#bdd0c9}.schedule b{font-size:1.45rem;color:#e3bd77}.schedule span{font-size:.72rem;color:#9eb5ad}.jumuah{grid-column:1/-1;display:flex;gap:1.5rem;align-items:center;padding:1.2rem 0;color:#dfe9e5}.jumuah strong{color:#e3bd77}.prayer-disclaimer{margin:1rem 0 0;color:#9eb5ad;font-size:.78rem}
.offering-section .section-head p{font-size:1.05rem}.service-grid{border-top:1px solid var(--line)}.service-card{display:grid;grid-template-columns:70px 1fr auto;gap:1.5rem;align-items:center;padding:2rem 0;border-bottom:1px solid var(--line)}.service-card>span{color:var(--gold);font-size:.78rem}.service-card h3{margin-bottom:.45rem;color:var(--green);font-size:clamp(1.45rem,3vw,2.1rem)}.service-card p{margin:0;max-width:650px;color:var(--muted)}.service-card i{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--line);border-radius:50%;color:var(--green);font-style:normal}
.community-section{padding:clamp(4.5rem,9vw,8rem) 0;background:var(--cream)}.community-filters{display:flex;gap:.4rem;flex-wrap:wrap}.filter{min-height:42px;padding:.5rem .9rem;border:1px solid #cfc1aa;border-radius:99px;background:transparent;color:var(--green);font-weight:750}.filter.active{background:var(--green);color:white;border-color:var(--green)}.community-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2.5rem,7vw,7rem)}.column-title{padding-bottom:1rem;border-bottom:1px solid #cfc1aa}.column-title>span,.card-label{text-transform:uppercase;letter-spacing:.13em;font-size:.68rem;font-weight:850;color:var(--gold)}.column-title h2{font-size:clamp(2rem,4vw,3rem);margin:.25rem 0}.event-card{display:grid;grid-template-columns:80px 1fr;gap:1.2rem;padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.event-card time{display:grid;align-content:start;text-align:center;border-right:1px solid #cfc1aa;color:var(--green)}.event-card time b{font-size:2rem}.event-card time span{text-transform:uppercase;font-size:.7rem}.event-card h3,.news-card h3{margin:.35rem 0 .55rem;color:var(--green)}.event-card p,.news-card p{margin-bottom:.7rem;color:var(--muted)}.event-card small{color:var(--green)}.news-card{padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.news-card:first-child{padding-top:2rem}
.give-section{padding:0 0 clamp(4.5rem,9vw,8rem);background:var(--cream)}.give-card{display:grid;grid-template-columns:1.3fr .7fr;gap:4rem;padding:clamp(2.2rem,6vw,5rem);background:#382820;color:white}.give-card h2{margin:.4rem 0 0;color:#fff}.give-card>div:last-child{align-self:end}.give-card p{color:#d8cbc2}.button.gold{background:var(--gold);border-color:var(--gold);color:#21170f}.visit{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem);align-items:center}.visit-copy h2{color:var(--green);margin:.5rem 0 1rem}.visit-copy p{color:var(--muted);max-width:360px}.location-card{display:grid;grid-template-columns:70px 1fr;gap:1.5rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.location-number{color:var(--gold)}.location-card h3{margin:.5rem 0;font-size:clamp(1.5rem,3vw,2.4rem);color:var(--green)}.location-card p{color:var(--muted);white-space:pre-line}.location-card a{color:var(--green);font-weight:800}.facility-list{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}.facility-list span{padding:.35rem .7rem;border:1px solid var(--line);border-radius:99px;font-size:.72rem;color:var(--muted)}.footer{background:#211914;color:white}.footer .site-footer{grid-template-columns:1fr auto auto;border:0;padding:3.5rem 0}.footer-brand{color:white}.footer-logo{display:grid;place-items:center;width:42px;height:42px;padding:4px;border-radius:50%;background:var(--ivory)}.footer-brand img{width:100%;height:100%;object-fit:contain}.site-footer p{margin:.8rem 0 0;color:#a99d96;max-width:330px;font-size:.82rem}.footer-links,.footer-meta{display:grid;align-content:start;gap:.55rem}.footer-links a,.footer-meta a{text-decoration:none}.footer-meta span{color:#a99d96}
@keyframes blink{50%{opacity:0}}@media(max-width:900px){.hero{min-height:auto;grid-template-columns:1fr;padding-top:5rem}.hero-art{min-height:480px}.hero-copy{max-width:700px}.prayer-panel{grid-template-columns:1fr}.prayer-lead{padding:2rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.2)}.community-grid,.give-card,.visit{grid-template-columns:1fr}.give-card{gap:2rem}.footer .site-footer{grid-template-columns:1fr 1fr}.footer-meta{grid-column:1/-1}}
@media(max-width:600px){.hero{padding:4rem 0}.hero-art{min-height:390px}.arch-window{inset:0 0 0 5%;border-radius:200px 200px 18px 18px}.hero-note{bottom:5%}.sun{width:120px;height:120px;right:-10px}.type-line{min-width:0}.schedule{grid-template-columns:repeat(2,1fr)}.schedule>div:nth-child(2n){border-right:0}.jumuah{align-items:flex-start;flex-direction:column;gap:.4rem}.service-card{grid-template-columns:35px 1fr}.service-card i{display:none}.community-filters{width:100%}.community-grid{gap:4rem}.event-card{grid-template-columns:62px 1fr}.give-card{width:100%;padding:2rem 1.3rem}.location-card{grid-template-columns:1fr}.location-number{display:none}.footer .site-footer{grid-template-columns:1fr}.footer-meta{grid-column:auto}.hero-copy>p{font-size:1rem}}
/* A quiet, centered visual language, scoped to the public homepage. */
main,.footer{font-family:"Source Sans 3",sans-serif;text-align:center}
main{background-color:#faf8f0;background-image:var(--pattern);background-size:380px}
main h1,main h2,main h3,.next-name{font-family:Lora,Georgia,serif;font-weight:500;letter-spacing:-.035em;text-align:center}
main h2{font-size:clamp(2rem,4vw,3.1rem);line-height:1.2}
.hero{display:block;min-height:0;padding:6rem 0 5rem}
.hero-copy{max-width:760px;margin:auto}
.hero h1{font-size:clamp(2.5rem,5.2vw,4.6rem);line-height:1.17;margin:0 auto 1.5rem}
.hero-copy>p{margin:1rem auto;max-width:580px;font-size:1.15rem;line-height:1.8}
.hero-copy>.hero-tagline{font-size:1.4rem;color:var(--green);font-family:Lora,Georgia,serif}
.type-line{min-width:5.1em;text-align:left}.hero-actions{justify-content:center}
.hero-art{min-height:0;margin:2.5rem auto 0}.arch-window,.sun{display:none}
.hero-note{position:static;display:grid;gap:.25rem;padding:0;background:transparent;border:0;box-shadow:none}
.hero-note span{font-size:1.8rem}.hero-note small{font-size:.9rem}
.section-head{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;text-align:center;margin-bottom:3rem}
.section-head h2{margin:0}.section-head p{max-width:600px;margin:0 auto;line-height:1.7}
.prayer-wrap{background:#164b3f;border-radius:0;padding:5rem 0}
.prayer-panel{border:1px solid #ffffff30;border-radius:24px;overflow:hidden;background:#ffffff05}
.prayer-lead{padding:2rem}.prayer-meta{justify-content:center;flex-wrap:wrap}.prayer-lead>p{margin:1.6rem 0 .5rem}
.next-row{justify-content:center;align-items:center;flex-wrap:wrap}.next-name{font-size:2.9rem}
.schedule>div{padding:1.6rem .7rem}.jumuah{justify-content:center;align-items:center;padding:1.3rem}
.offering-section{position:relative;padding-top:6rem;padding-bottom:6rem}.services-section{padding-top:0}
.service-grid{border:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1.6rem}
.service-card{display:flex;flex-direction:column;align-items:center;gap:0;text-align:center;padding:2.5rem 1.8rem 1.8rem;border:1px solid #e8e4d7;border-radius:24px;background:#fffefa;box-shadow:0 8px 24px #163e2d07;transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
.service-card>.service-icon{display:grid;place-items:center;width:76px;height:76px;border-radius:20px;color:#fff;background:#1d6049;margin-bottom:1.5rem;box-shadow:0 6px 14px #164b3f18}
.service-icon svg{width:36px;height:36px}.service-card h3{font-size:1.6rem;margin:0 0 1rem;line-height:1.3}
.service-card p{font-size:1.05rem;line-height:1.8;margin-bottom:1.8rem;max-width:30ch}
.service-card .service-action{margin-top:auto;width:100%;justify-content:center;border-radius:12px;background:#1d6049;border-color:#1d6049;font-weight:600}
.community-section{background:#f1eee4;padding:5rem 0}.community-filters{justify-content:center}
.community-grid{grid-template-columns:1fr 1fr;gap:2rem}.column-title{border:0;margin-bottom:1.25rem}.column-title h2{font-size:1.9rem}
.event-card,.news-card{display:flex;flex-direction:column;align-items:center;gap:.6rem;background:#fffefa;border:1px solid #e3dece;border-radius:24px;padding:2rem;margin-bottom:1.25rem;box-shadow:0 6px 20px #163e2d04;transition:transform .3s ease,box-shadow .3s ease,border-color .3s ease}
.event-card time{border:0;border-radius:14px;background:#e9efe6;padding:.6rem 1.4rem;min-width:80px}.event-card time b{font-family:Lora,serif;font-size:1.9rem}
.event-card h3,.news-card h3{font-size:1.5rem}.event-card p,.news-card p{line-height:1.8}
.news-card:first-child{padding-top:2rem}.card-label{letter-spacing:.06em}
.give-section{padding:1rem 0 5rem;background:#f1eee4}.give-card{display:block;max-width:1000px;border-radius:28px;background:#164b3f;padding:3.5rem 2rem}
.give-card h2{max-width:650px;margin:0 auto 1.3rem}.give-card p{color:#e1e9df}.give-card .button{margin-top:.5rem}
.visit{display:flex;flex-direction:column;gap:2rem;padding-top:5rem;padding-bottom:5rem}.visit-copy p{max-width:560px}
.location-card{display:block;width:min(100%,740px);border-radius:24px;box-shadow:0 8px 24px #163e2d07}
.facility-list{justify-content:center}.footer{background:#103a30}.footer .site-footer{display:flex;flex-direction:column;align-items:center;gap:2rem}
.footer-brand,.footer-links,.footer-meta{justify-content:center}.footer-links{display:flex;flex-wrap:wrap;gap:1.5rem}.site-footer p{max-width:none}.footer-meta{justify-items:center}
@media(hover:hover){.service-card:hover,.event-card:hover,.news-card:hover{transform:translateY(-6px);box-shadow:0 18px 36px #163e2d14;border-color:#b4c5ae}}
.service-card:focus-within{box-shadow:0 0 0 3px #b4c5ae}

main .reveal{animation:none}
main .reveal.is-pending{opacity:0;transform:translateY(22px);filter:blur(4px)}
main .reveal.is-visible{animation:masjid-reveal .7s both;animation-delay:var(--delay,0ms)}
@keyframes masjid-reveal{from{opacity:0;transform:translateY(22px);filter:blur(4px)}to{opacity:1;transform:translateY(0);filter:blur(0)}}
.site-header{--scroll-progress:0;overflow:visible}.site-header:after{content:"";position:absolute;left:18px;right:18px;bottom:-1px;height:2px;border-radius:999px;background:var(--gold);transform:scaleX(var(--scroll-progress));transform-origin:left;transition:transform .12s linear}.nav a{position:relative;transition:color .2s ease}.nav a:after{content:"";position:absolute;left:0;right:0;bottom:-.25rem;height:2px;background:var(--gold);transform:scaleX(0);transform-origin:center;transition:transform .25s ease}.nav a[aria-current="location"]{color:var(--green)}.nav a[aria-current="location"]:after{transform:scaleX(1)}
.hero-art{transform:translateY(var(--hero-shift,0px))}
@media(max-width:900px){.service-grid{grid-template-columns:1fr;max-width:580px;margin:auto}.community-grid{grid-template-columns:1fr}.hero{padding:4rem 0}.jumuah{flex-wrap:wrap}.service-card p{max-width:40ch}}
@media(max-width:600px){.hero h1{font-size:2.6rem}.hero-copy>.hero-tagline{font-size:1.2rem}.hero-copy>p{font-size:1.05rem}.hero-actions{gap:1rem}.service-card{padding:2rem 1.5rem}.prayer-lead{padding:1.5rem}.give-card{width:calc(100% - 2rem);padding:2.5rem 1.5rem}.section-head{margin-bottom:2rem}.jumuah{align-items:center}.community-filters{width:auto}}
@media(prefers-reduced-motion:reduce){.type-line.typing:after{animation:none}.reveal.is-pending{opacity:1;transform:none;filter:none}.reveal.is-visible{animation:none}.site-header:after,.nav a,.nav a:after{transition:none}.hero-art{transform:none}.service-card,.event-card,.news-card{transition:none}.service-card:hover,.event-card:hover,.news-card:hover{transform:none}}

.site-header>.brand{min-width:0}.brand-name{display:block;max-width:32ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.campus-locations{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:1.5rem;width:100%;max-width:1000px}.location-card{width:100%;min-width:0}.location-card[data-selected="true"]{border-color:#759888}.campus-selection{font-size:.9rem;color:var(--green)}.contact-actions{display:flex;justify-content:center;flex-wrap:wrap;gap:.6rem 1.3rem}.contact-actions a{display:inline-flex;align-items:center;min-height:44px}.location-select{margin:1.25rem auto 0}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
#campus-dialog{width:min(620px,calc(100% - 32px));max-height:min(760px,calc(100dvh - 32px));padding:clamp(1.5rem,5vw,2.7rem);border:1px solid var(--line);border-radius:28px;background:var(--paper);color:var(--ink);box-shadow:0 34px 100px rgba(9,29,25,.38);overflow:auto}#campus-dialog::backdrop{background:rgba(19,45,40,.68);backdrop-filter:blur(4px)}#campus-dialog h2{margin:0 2.5rem .8rem;color:var(--green);font:500 clamp(2rem,6vw,2.8rem)/1.1 Lora,Georgia,serif;text-align:center}#campus-dialog>p{max-width:500px;margin:0 auto 1.5rem;color:var(--muted);text-align:center}.dialog-close{position:absolute;top:1rem;right:1rem;width:44px;height:44px;border:0;border-radius:50%;background:var(--cream);color:var(--green);font-size:1.5rem}.campus-dialog-options{display:grid;gap:.75rem}.campus-choice{display:grid;grid-template-columns:auto 1fr;align-items:center;gap:.9rem;min-height:72px;padding:.85rem 1rem;border:1px solid var(--line);border-radius:16px;background:#fff;cursor:pointer}.campus-choice:has(input:checked){border:2px solid var(--green);background:#f0f4ef}.campus-choice input{width:20px;height:20px;margin:0;accent-color:var(--green)}.campus-choice span{display:grid;text-align:left}.campus-choice b{color:var(--green)}.campus-choice small{color:var(--muted)}.campus-dialog-continue{width:100%;margin-top:1.25rem}.campus-dialog-continue:disabled{opacity:.55;cursor:not-allowed}
@media(max-width:700px){.brand-name{max-width:24ch}.site-header{gap:.5rem}}
@media(max-width:430px){.brand-name{display:none}#campus-dialog{padding:1.5rem 1rem;border-radius:22px}#campus-dialog h2{font-size:2rem}}
</style>

<script define:vars={{ basePath, initialSite: site }}>
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  const header = document.querySelector('#site-header');
  const navLinks = [...document.querySelectorAll('[data-nav-target]')];
  const navSections = navLinks.map((link) => ({link, section: document.querySelector(`#${link.dataset.navTarget}`)})).filter((item) => item.section);
  const heroArt = document.querySelector('.hero-art');
  const updateLogo = (value) => {
    let source = '';
    if (/^\/?[a-zA-Z0-9_-]+(?:\/[a-zA-Z0-9_-]+)*\.(?:svg|png|webp|jpg|jpeg|avif)$/i.test(value || '')) source = `${basePath}${value.replace(/^\//, '')}`;
    else { try { const url = new URL(value); if (url.protocol === 'https:' && !url.username && !url.password && !/[\s\\]/.test(value)) source = url.href; } catch {} }
    if (!source) return;
    document.querySelectorAll('[data-site-logo]').forEach((image) => { image.src = source; });
    const favicon = document.querySelector('link[rel="icon"]'); if (favicon) favicon.href = source;
  };
  let scrollFrame = 0;
  const updateScrollUI = () => {
    scrollFrame = 0;
    const maxScroll = Math.max(1, document.documentElement.scrollHeight - innerHeight);
    const progress = Math.min(1, Math.max(0, scrollY / maxScroll));
    header?.style.setProperty('--scroll-progress', String(progress));
    if (!reducedMotion.matches) heroArt?.style.setProperty('--hero-shift', `${Math.min(34, scrollY * 0.045)}px`);
    const focusLine = innerHeight * 0.36;
    const active = navSections.filter(({section}) => section.getBoundingClientRect().top <= focusLine).at(-1)?.link;
    navLinks.forEach((link) => link === active ? link.setAttribute('aria-current', 'location') : link.removeAttribute('aria-current'));
  };
  const scheduleScrollUI = () => { if (!scrollFrame) scrollFrame = requestAnimationFrame(updateScrollUI); };
  addEventListener('scroll', scheduleScrollUI, {passive:true});
  addEventListener('resize', scheduleScrollUI, {passive:true});
  updateScrollUI();
  const revealObserver = !reducedMotion.matches && 'IntersectionObserver' in window ? new IntersectionObserver(entries => entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    entry.target.classList.remove('is-pending');
    entry.target.classList.add('is-visible');
    entry.target.addEventListener('animationend', () => entry.target.classList.remove('is-visible'), {once:true});
    revealObserver.unobserve(entry.target);
  }), {threshold:0.08}) : null;
  const observeReveals = () => document.querySelectorAll('.reveal:not([data-observed])').forEach(node => {
    node.dataset.observed = 'true';
    if (revealObserver) { node.classList.add('is-pending'); revealObserver.observe(node); }
  });
  observeReveals();
  const filters = document.querySelectorAll('[data-filter]');
  const campusDialog = document.querySelector('#campus-dialog');
  const campusDialogOptions = document.querySelector('#campus-dialog-options');
  const campusDialogContinue = document.querySelector('#campus-dialog-continue');
  const text = (selector, value) => { const element = document.querySelector(selector); if (element) element.textContent = value ?? ''; };
  const element = (tag, className, content) => { const node = document.createElement(tag); if (className) node.className = className; if (content !== undefined) node.textContent = content; return node; };
  const formatDate = (value, options) => new Date(value).toLocaleDateString(undefined, options);
  const applyFilter = (kind) => document.querySelectorAll('[data-section-kind]').forEach((section) => { section.hidden = kind !== 'all' && section.dataset.sectionKind !== kind; });
  const renderCommunity = (content, campusId) => {
    const eventRoot = document.querySelector('#event-cards');
    const announcementRoot = document.querySelector('#announcement-cards');
    eventRoot?.replaceChildren(); announcementRoot?.replaceChildren();
    content.events.filter((item) => !item.campusIds.length || item.campusIds.includes(campusId)).slice(0, 3).forEach((item) => {
      const card = element('article', 'event-card reveal'); card.dataset.kind = 'event';
      const time = element('time'); time.dateTime = item.startsAt; time.append(element('b', '', formatDate(item.startsAt, {day:'2-digit'})), element('span', '', formatDate(item.startsAt, {month:'short'})));
      const body = element('div'); body.append(element('span','card-label',item.category),element('h3','',item.title),element('p','',item.description),element('small','',item.location)); card.append(time,body); eventRoot?.append(card);
    });
    const now=Date.now(); content.announcements.filter((item) => (!item.campusIds.length || item.campusIds.includes(campusId)) && Date.parse(item.publishedAt) <= now && (!item.expiresAt || now < Date.parse(item.expiresAt))).forEach((item) => { const card=element('article','news-card reveal'); card.dataset.kind='announcement'; card.append(element('span','card-label','Community note'),element('h3','',item.title),element('p','',item.body)); announcementRoot?.append(card); });
    applyFilter(document.querySelector('[data-filter].active')?.dataset.filter || 'all');
    observeReveals();
  };
  const renderCampus = (content, campusId) => {
    const campus = content.campuses.find((item) => item.id === campusId) || content.campuses[0]; if (!campus) return;
    const now = new Date();
    const date = new Intl.DateTimeFormat('en-CA',{timeZone:campus.timezone,year:'numeric',month:'2-digit',day:'2-digit'}).format(now);
    const currentTime = new Intl.DateTimeFormat('en-US',{timeZone:campus.timezone,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(now);
    const row = campus.timetable.find((item) => item.date === date) || campus.timetable[0];
    const keys=['fajr','dhuhr','asr','maghrib','isha']; const nextKey=keys.find((key)=>row && row[key]>currentTime)||'fajr';
    text('#today',date); text('#campus-name',campus.name); text('#next-name',nextKey[0].toUpperCase()+nextKey.slice(1)); text('#next-time',row?.[nextKey]||'—'); text('#next-iqamah',`Iqamah ${row?.iqamah?.[nextKey]||campus.iqamah[nextKey]}`);
    ['fajr','sunrise','dhuhr','asr','maghrib','isha'].forEach((key)=>{text(`[data-prayer="${key}"]`,row?.[key]||'—');if(key!=='sunrise')text(`[data-iqamah="${key}"]`,`Iqamah ${row?.iqamah?.[key]||campus.iqamah[key]}`)});
    const jumuah=document.querySelector('#jumuah'); if(jumuah){jumuah.replaceChildren(element('strong','','Jumuah'),...campus.jumuah.map((item)=>element('span','',`${item.label} · ${item.time}`)))}
    const locations=document.querySelector('#campus-locations');
    locations?.replaceChildren(...content.campuses.map((item)=>{
      const selected=item.id===campus.id;
      const card=element('article','location-card reveal');card.dataset.campusId=item.id;card.dataset.selected=String(selected);
      card.append(element('span','campus-selection',selected?'Current location':'Location'),element('h3','',item.name),element('p','',`${item.address}\n${item.city}`));
      const actions=element('div','contact-actions');
      [['Email',`mailto:${item.email}`],['Call',`tel:${item.phone}`],['Directions',`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${item.address}, ${item.city}`)}`]].forEach(([label,href])=>{
        const link=element('a','',label);link.href=href;link.setAttribute('aria-label',`${label} ${item.name}${label==='Directions'?' (opens a new tab)':''}`);
        if(label==='Directions'){link.target='_blank';link.rel='noopener noreferrer';link.append(' ↗');}actions.append(link);
      });
      const facilities=element('div','facility-list');facilities.append(...item.facilities.map((name)=>element('span','',name)));card.append(actions,facilities);
      if(!selected&&content.campuses.length>1){const choose=element('button','button secondary location-select',`Use ${item.name}`);choose.type='button';choose.dataset.selectCampus=item.id;choose.addEventListener('click',()=>selectCampus(item.id,content));card.append(choose);}
      return card;
    }));
    document.querySelectorAll('[data-campus-ids]').forEach((card)=>{const ids=(card.dataset.campusIds||'').split(',').filter(Boolean);card.hidden=ids.length>0&&!ids.includes(campus.id);});
    renderCommunity(content,campus.id);observeReveals();
  };
  const selectCampus=(campusId,content,persist=true)=>{const selected=content.campuses.some((item)=>item.id===campusId)?campusId:content.campuses[0]?.id;if(!selected)return;if(persist){localStorage.setItem('openmasjid-campus',selected);const url=new URL(location.href);url.searchParams.set('campus',selected);history.replaceState({},'',url)}updateLogo(content.organization?.logo);renderCampus(content,selected)};
  const showCampusChooser=(content,selectedId)=>{
    if(!campusDialog||!campusDialogOptions||!campusDialogContinue||content.campuses.length<2)return;
    campusDialogOptions.replaceChildren(...content.campuses.map((item,index)=>{
      const label=element('label','campus-choice');const input=element('input');input.type='radio';input.name='campus-choice';input.value=item.id;input.checked=item.id===selectedId||(!selectedId&&index===0);
      const copy=element('span');copy.append(element('b','',item.name),element('small','',item.city));label.append(input,copy);
      input.addEventListener('change',()=>{campusDialogContinue.disabled=false;campusDialogContinue.textContent=`Continue with ${item.name}`;});return label;
    }));
    const selected=content.campuses.find((item)=>item.id===selectedId)||content.campuses[0];campusDialogContinue.disabled=false;campusDialogContinue.textContent=`Continue with ${selected.name}`;
    campusDialogContinue.onclick=()=>{const choice=campusDialogOptions.querySelector('input:checked');if(choice){selectCampus(choice.value,content);campusDialog.close();}};
    if(!campusDialog.open)campusDialog.showModal();
  };
  document.querySelector('#campus-dialog-close')?.addEventListener('click',()=>campusDialog?.close());
  filters.forEach((button)=>button.addEventListener('click',()=>{filters.forEach((item)=>item.classList.toggle('active',item===button));applyFilter(button.dataset.filter)}));
  document.querySelectorAll('[data-select-campus]').forEach((button)=>button.addEventListener('click',()=>selectCampus(button.dataset.selectCampus,window.__openMasjidSite||initialSite)));
  const requested=new URLSearchParams(location.search).get('campus');const remembered=localStorage.getItem('openmasjid-campus');
  const initializeCampus=(content)=>{window.__openMasjidSite=content;const selected=requested||remembered||content.campuses[0]?.id;selectCampus(selected,content,Boolean(remembered));if(!remembered)showCampusChooser(content,selected)};
  fetch(new URL(`${basePath}data/v1/site.json`,location.href),{cache:'no-store'}).then((response)=>{if(!response.ok)throw new Error(String(response.status));return response.json()}).then(initializeCampus).catch(()=>initializeCampus(initialSite));
  const typeLine=document.querySelector('.type-line'); if(typeLine&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const words=JSON.parse(typeLine.dataset.words);let word=0,char=words[0].length,deleting=true;typeLine.classList.add('typing');const tick=()=>{const target=words[word];if(deleting){char-=1;if(char===0){typeLine.textContent='';deleting=false;word=(word+1)%words.length;setTimeout(tick,350);return}}else{char+=1;if(char===target.length){deleting=true;typeLine.textContent=target;setTimeout(tick,1500);return}}typeLine.textContent=(deleting?target:words[word]).slice(0,char);setTimeout(tick,deleting?65:105)};setTimeout(tick,1400)}
</script>
