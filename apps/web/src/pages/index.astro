---
import Base from '../layouts/Base.astro';
import site from '../lib/site.json';
import { formatPrayerCountdown, getPrayerTiming, localDate, resolveCampusId, campusEvents, campusAnnouncements, resolveAssetUrl, resolveTabLogo } from '../lib/site';
const campusId = resolveCampusId(site);
const campus = site.campuses.find((item) => item.id === campusId)!;
const today = localDate(campus.timezone);
const row = campus.timetable.find((item) => item.date === today);
const timing = getPrayerTiming(campus.timetable, campus.timezone);
const events = campusEvents(site, campusId).slice(0, 3);
const announcements = campusAnnouncements(site, campusId).slice(0, 3);
const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
const tabLogoUrl = resolveTabLogo(site, basePath);
const tabLogoDarkUrl = resolveTabLogo(site, basePath, true);
const locationLabel = site.campuses.length === 1 ? 'Location' : 'Locations';
const volunteerHref = site.volunteer.mode === 'external' ? site.volunteer.externalUrl : `${basePath}volunteer/`;
const prayerKeys = ['fajr','sunrise','dhuhr','asr','maghrib','isha'] as const;
const prayerNames = { fajr: 'Fajr', sunrise: 'Shuruq', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha' } as const;
const offeringSections = [
  { id: 'programs', title: 'Programs', description: 'Learn, grow, and build lasting connections through gatherings for every stage of life.', items: site.programs },
  { id: 'services', title: 'Services', description: 'Practical, spiritual, and community support when you need it.', items: site.services },
];
---
<Base title={`${site.organization.name} · ${campus.name}`} description={site.organization.tagline} icon={tabLogoUrl} iconDark={tabLogoDarkUrl}>
  <link rel="stylesheet" href={`${basePath}assets/fonts/fonts.css`} />
  <header class="container site-header" id="site-header">
    <a class="brand" href={basePath} aria-label={site.organization.name}><img src={logoUrl} data-site-logo alt="" /><span class="brand-name">{site.organization.name}</span></a>
    <nav class="nav" aria-label="Primary"><a href="#prayer" data-nav-target="prayer">Prayer</a><a href="#programs" data-nav-target="programs">Programs</a><a href="#services" data-nav-target="services">Services</a><a href="#community" data-nav-target="community">Community</a><a href="#locations" data-nav-target="locations" data-location-label>{locationLabel}</a></nav>
    <a class="button header-action" href={`${basePath}donate/`}>Donate <span aria-hidden="true">↗</span></a>
  </header>

  <dialog id="campus-dialog" aria-labelledby="campus-dialog-title" aria-describedby="campus-dialog-description">
    <button type="button" class="dialog-close" id="campus-dialog-close" aria-label="Decide later">×</button>
    <h2 id="campus-dialog-title">Choose your location</h2>
    <p id="campus-dialog-description">We’ll personalize prayer times, events, and community updates. Your choice is remembered on this device.</p>
    <div class="campus-dialog-options" id="campus-dialog-options" role="radiogroup" aria-label={locationLabel}></div>
    <button type="button" class="button campus-dialog-continue" id="campus-dialog-continue" disabled>Choose a location</button>
  </dialog>

  <main style={`--pattern:url("${basePath}assets/mosque-pattern.svg")`}>
    <section class="container hero" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <h1 id="hero-title">Rooted in faith.<br />Open to all.</h1>
        <p class="hero-tagline" aria-label="A place to belong, worship, grow, and gather.">A place to <span aria-hidden="true" class="type-line" data-words='["belong.","worship.","grow.","gather."]'>belong.</span></p>
        <p>{site.organization.description}</p>
        <div class="hero-actions"><a class="button" href="#prayer">View prayer times <span aria-hidden="true">↓</span></a><a class="text-link" href="#programs">Explore our community <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-art reveal" style="--delay:120ms" aria-hidden="true">
        <div class="sun"></div><div class="arch-window"><img src={logoUrl} data-site-logo alt="" /></div>
        <div class="hero-note"><span>السلام عليكم</span><small>Peace be upon you</small></div>
      </div>
    </section>

    <section class="prayer-wrap" id="prayer" aria-labelledby="prayer-title" style={`--prayer-accent:${site.organization.theme.accent};--prayer-background:${site.organization.theme.background}`}>
      <div class="container">
        <div class="section-head light reveal"><div><h2 id="prayer-title">Prayer times</h2></div></div>
        <div class="prayer-panel reveal" id="prayer-panel">
          <div class="prayer-lead"><div class="prayer-meta"><span id="campus-name">{campus.name}</span><span id="today">{today}</span></div><div class="next-prayer-copy"><p>Next prayer</p><div class="next-summary"><strong class="next-name" id="next-name">{timing ? prayerNames[timing.nextKey] : 'Schedule'}</strong></div></div><span class="countdown-label">Begins in <span role="timer" aria-live="off" id="prayer-countdown">{timing ? formatPrayerCountdown(timing.countdownSeconds) : '--:--:--'}</span></span></div>
          <div class="web-prayer-board">
            <ul class="schedule" id="schedule" aria-label="Daily prayer times">{prayerKeys.map((key) => <li aria-label={key === 'sunrise' ? `Shuruq, ${row?.sunrise ?? 'not available'}` : `${prayerNames[key]}, Adhan ${row?.[key] ?? 'not available'}, Iqamah ${row?.iqamah?.[key] ?? campus.iqamah[key]}`} data-prayer-card={key} data-prayer-state={timing?.nextKey === key ? 'next' : timing?.currentKey === key ? 'current' : 'upcoming'}><small>{prayerNames[key]}</small>{key !== 'sunrise' && <span class="adhan-label">Adhan</span>}<b data-prayer={key}>{row?.[key] ?? 'Not available'}</b>{key !== 'sunrise' && <><span class="iqamah-label">Iqamah</span><b data-iqamah={key}>{row?.iqamah?.[key] ?? campus.iqamah[key]}</b></>}</li>)}</ul>
              <div id="jumuah" class="jumuah" data-website-jumuah><strong>Jumuah</strong>{campus.jumuah.map((gathering) => <span>{gathering.label} · {gathering.time}</span>)}</div>
          </div>
        </div>
        <p class="prayer-disclaimer">Times are for the selected campus. Confirm locally for special days and schedule changes.</p>
      </div>
    </section>

    {offeringSections.map((section, sectionIndex) => <section class:list={['container','section','offering-section',`${section.id}-section`]} id={section.id} aria-labelledby={`${section.id}-title`}>
      <div class="section-head reveal"><div><h2 id={`${section.id}-title`}>{section.title}</h2></div><p class="muted">{section.description}</p></div>
      <div class="service-grid">{section.items.map((item, index) => <article class="service-card reveal" style={`--delay:${index * 90}ms`} data-campus-ids={item.campusIds.join(',')} hidden={item.campusIds.length > 0 && !item.campusIds.includes(campusId)}>
        <span class="service-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          {sectionIndex === 0 ? (index % 2 === 0 ? <><path d="M12 6C9 3 5 3 2 4v15c4-1 7-1 10 2 3-3 6-3 10-2V4c-3-1-7-1-10 2Z"/><path d="M12 6v15"/></> : <><circle cx="12" cy="8" r="3"/><path d="M5 21c.7-5 3-7 7-7s6.3 2 7 7"/></>) : (index % 2 === 0 ? <><circle cx="12" cy="12" r="9"/><path d="M12 7v5l4 2"/></> : <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8L12 21l8.8-8.6a5.5 5.5 0 0 0 0-7.8Z"/>)}
        </svg></span>
        <h3>{item.title}</h3><p>{item.description}</p>
        {item.details.enabled && <a class="button service-action" href={`${basePath}${section.id}/${item.id}/`}>More information <span aria-hidden="true">→</span></a>}
      </article>)}</div>
    </section>)}

    <section class="community-section" id="community">
      <div class="container">
        <div class="section-head reveal"><div><h2>Gather. Learn. Connect.</h2></div><div class="community-filters" role="group" aria-label="Filter community content"><button type="button" class="filter active" data-filter="all">All</button><button type="button" class="filter" data-filter="announcement">Announcements</button><button type="button" class="filter" data-filter="event">Events</button></div></div>
        <div id="community-cards" class="community-grid">
          <section class="events-column" data-section-kind="event" aria-labelledby="events-title"><div class="column-title"><h2 id="events-title">Upcoming events</h2></div><div id="event-cards">{events.map((item) => <article class="event-card reveal" data-kind="event"><time datetime={item.startsAt}><b>{new Date(item.startsAt).toLocaleDateString(undefined,{day:'2-digit'})}</b><span>{new Date(item.startsAt).toLocaleDateString(undefined,{month:'short'})}</span></time><div><span class="card-label">{item.category}</span><h3>{item.title}</h3><p>{item.description}</p><small>{item.location}</small></div></article>)}</div></section>
          <section class="news-column" data-section-kind="announcement" aria-labelledby="announcements-title"><div class="column-title"><h2 id="announcements-title">Announcements</h2></div><div id="announcement-cards">{announcements.map((item) => <article class="news-card reveal" data-kind="announcement"><span class="card-label">Community note</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
        </div>
      </div>
    </section>

    {site.volunteer.enabled && volunteerHref && <section class="volunteer-section" id="volunteer" aria-labelledby="volunteer-title"><div class="container volunteer-card reveal"><div class="volunteer-mark" aria-hidden="true"><svg viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><path d="M32 54S9 42 9 23a11 11 0 0 1 20-7l3 4 3-4a11 11 0 0 1 20 7c0 19-23 31-23 31Z"/><path d="M32 20v25M21 32h22"/></svg></div><div class="volunteer-copy"><h2 id="volunteer-title">{site.volunteer.title}</h2><p>{site.volunteer.description}</p></div><a class="button gold volunteer-action" href={volunteerHref}>{site.volunteer.buttonLabel} <span aria-hidden="true">→</span></a></div></section>}

    <section class="give-section"><div class="container give-card reveal"><div><h2>Your generosity makes room for everyone.</h2></div><div><p>Support prayer, learning, care, and connection across our community.</p><a class="button gold" href={`${basePath}donate/`}>Make a donation <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="container section visit" id="locations" aria-labelledby="locations-title">
      <div class="visit-copy reveal"><h2 id="locations-title" data-location-label>{locationLabel}</h2><p id="location-copy">{site.campuses.length === 1 ? 'Get directions or contact the team directly.' : 'Choose your location, get directions, or contact its team directly.'}</p></div>
      <div class="campus-locations" id="campus-locations">{site.campuses.map((item) => <article class="location-card reveal" data-campus-id={item.id} data-selected={item.id === campusId ? 'true' : 'false'}>
        <span class="campus-selection">{item.id === campusId ? 'Current location' : 'Location'}</span><h3>{item.name}</h3><p>{item.address}<br />{item.city}</p>
        <div class="contact-actions"><a href={`mailto:${item.email}`} aria-label={`Email ${item.name}`}>{item.email}</a><a href={`tel:${item.phone}`} aria-label={`Call ${item.name}`}>{item.phone}</a><a href={`https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${item.address}, ${item.city}`)}`} target="_blank" rel="noopener noreferrer">Directions <span class="sr-only">to {item.name} (opens a new tab)</span> ↗</a></div>
        <div class="facility-list">{item.facilities.map((facility) => <span>{facility}</span>)}</div>
        {item.id !== campusId && <button type="button" class="button secondary location-select" data-select-campus={item.id}>Use {item.name}</button>}
      </article>)}</div>
    </section>
  </main>

  <footer class="footer"><div class="container site-footer"><div><div class="footer-brand"><span class="footer-logo"><img src={logoUrl} data-site-logo alt="" /></span><span>{site.organization.name}</span></div></div><div class="footer-links"><a href="#prayer">Prayer times</a><a href="#programs">Programs</a><a href="#services">Services</a><a href="#community">Community</a><a href="#locations" data-location-label>{locationLabel}</a></div><div class="footer-meta"><a href={`mailto:${site.organization.email}`}>{site.organization.email}</a><span>© {new Date().getFullYear()} {site.organization.name}</span></div></div></footer>
</Base>

<style is:global>
.hero{min-height:760px;padding:clamp(5rem,10vw,9rem) 0 7rem;display:grid;grid-template-columns:1.06fr .94fr;align-items:center;gap:clamp(2rem,6vw,6rem)}.hero-copy{position:relative;z-index:1}.hero h1{margin:.6rem 0 1.8rem;color:var(--green);max-width:760px}.type-line{display:inline-block;color:var(--gold);min-width:5.8em}.type-line.typing:after{content:"";display:inline-block;width:3px;height:.75em;margin-left:.08em;background:currentColor;animation:blink .8s steps(1) infinite}.hero-copy>p{max-width:540px;font-size:1.08rem;color:var(--muted)}.hero-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}.text-link{min-height:44px;display:inline-flex;align-items:center;gap:.5rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}.hero-art{position:relative;min-height:570px}.arch-window{position:absolute;inset:0 0 0 14%;display:grid;place-items:center;border-radius:260px 260px 22px 22px;background:var(--green);overflow:hidden;box-shadow:var(--shadow)}.arch-window:before,.arch-window:after{content:"";position:absolute;border:1px solid rgba(224,193,128,.34);border-radius:50%}.arch-window:before{width:430px;height:430px}.arch-window:after{width:300px;height:300px}.arch-window img{position:relative;z-index:1;width:38%;opacity:.92}.sun{position:absolute;z-index:-1;width:190px;height:190px;right:-12%;top:2%;border-radius:50%;background:var(--gold)}.hero-note{position:absolute;z-index:2;left:0;bottom:8%;display:grid;padding:1.1rem 1.4rem;border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.hero-note span{font-family:Georgia,serif;font-size:1.8rem;color:var(--green)}.hero-note small{color:var(--muted)}
.prayer-wrap{padding:clamp(4.5rem,8vw,7rem) 0;background:var(--prayer-accent,var(--green));color:white}.section-head.light h2{color:white}.prayer-panel{display:grid;grid-template-columns:minmax(220px,.72fr) minmax(0,2fr);gap:1rem}.prayer-lead{display:grid;align-content:center;justify-items:center;padding:2rem;border:1px solid rgba(255,255,255,.18);border-radius:22px;background:rgba(255,255,255,.05)}.prayer-meta{display:flex;justify-content:center;flex-wrap:wrap;gap:.5rem 1rem;color:#bdd0c9;font-size:.82rem}.prayer-lead>p{margin:1.8rem 0 .2rem;color:#bdd0c9}.next-summary{display:flex;align-items:baseline;justify-content:center;gap:.8rem;flex-wrap:wrap}.next-name{font-size:clamp(2.2rem,5vw,3.4rem);font-family:"Trebuchet MS",sans-serif}.next-summary>b{font-size:1.6rem;color:#e3bd77}.countdown-label{display:grid;margin-top:1rem;color:#bdd0c9;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em}.countdown-label [role="timer"]{color:white;font-size:1.25rem;font-weight:800;font-variant-numeric:tabular-nums;letter-spacing:.08em}.schedule{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;padding:0;margin:0;list-style:none}.schedule>li{position:relative;display:grid;align-content:center;gap:.35rem;min-width:0;min-height:132px;padding:1.2rem;border:1px solid rgba(255,255,255,.15);border-radius:18px;background:rgba(255,255,255,.04);text-align:left}.schedule>li[data-prayer-state="next"]{border-color:var(--prayer-background,#e3bd77);background:var(--prayer-background,#e3bd77);color:var(--prayer-accent,#173c34)}.schedule>li[data-prayer-state="next"] small,.schedule>li[data-prayer-state="next"] b,.schedule>li[data-prayer-state="next"] span{color:var(--prayer-accent,#173c34)}.schedule small{text-transform:uppercase;letter-spacing:.1em;color:#bdd0c9}.schedule b{font-size:1.55rem;color:#fff;font-variant-numeric:tabular-nums}.schedule span{font-size:.75rem;color:#9eb5ad}.jumuah{grid-column:1/-1;display:flex;justify-content:center;gap:1.5rem;align-items:center;padding:1.2rem;border-top:1px solid rgba(255,255,255,.18);color:#dfe9e5}.jumuah strong{color:#e3bd77}.prayer-disclaimer{margin:1rem 0 0;color:#9eb5ad;font-size:.78rem}
.offering-section .section-head p{font-size:1.05rem}.service-grid{border-top:1px solid var(--line)}.service-card{display:grid;grid-template-columns:70px 1fr auto;gap:1.5rem;align-items:center;padding:2rem 0;border-bottom:1px solid var(--line)}.service-card>span{color:var(--gold);font-size:.78rem}.service-card h3{margin-bottom:.45rem;color:var(--green);font-size:clamp(1.45rem,3vw,2.1rem)}.service-card p{margin:0;max-width:650px;color:var(--muted)}.service-card i{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--line);border-radius:50%;color:var(--green);font-style:normal}
.community-section{padding:clamp(4.5rem,9vw,8rem) 0;background:var(--cream)}.community-filters{display:flex;gap:.4rem;flex-wrap:wrap}.filter{min-height:42px;padding:.5rem .9rem;border:1px solid #cfc1aa;border-radius:99px;background:transparent;color:var(--green);font-weight:750}.filter.active{background:var(--green);color:white;border-color:var(--green)}.community-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2.5rem,7vw,7rem)}.column-title{padding-bottom:1rem;border-bottom:1px solid #cfc1aa}.column-title>span,.card-label{text-transform:uppercase;letter-spacing:.13em;font-size:.68rem;font-weight:850;color:var(--gold)}.column-title h2{font-size:clamp(2rem,4vw,3rem);margin:.25rem 0}.event-card{display:grid;grid-template-columns:80px 1fr;gap:1.2rem;padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.event-card time{display:grid;align-content:start;text-align:center;border-right:1px solid #cfc1aa;color:var(--green)}.event-card time b{font-size:2rem}.event-card time span{text-transform:uppercase;font-size:.7rem}.event-card h3,.news-card h3{margin:.35rem 0 .55rem;color:var(--green)}.event-card p,.news-card p{margin-bottom:.7rem;color:var(--muted)}.event-card small{color:var(--green)}.news-card{padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.news-card:first-child{padding-top:2rem}
.give-section{padding:0 0 clamp(4.5rem,9vw,8rem);background:var(--cream)}.give-card{display:grid;grid-template-columns:1.3fr .7fr;gap:4rem;padding:clamp(2.2rem,6vw,5rem);background:#382820;color:white}.give-card h2{margin:.4rem 0 0;color:#fff}.give-card>div:last-child{align-self:end}.give-card p{color:#d8cbc2}.button.gold{background:var(--gold);border-color:var(--gold);color:#21170f}.visit{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem);align-items:center}.visit-copy h2{color:var(--green);margin:.5rem 0 1rem}.visit-copy p{color:var(--muted);max-width:360px}.location-card{display:grid;grid-template-columns:70px 1fr;gap:1.5rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.location-number{color:var(--gold)}.location-card h3{margin:.5rem 0;font-size:clamp(1.5rem,3vw,2.4rem);color:var(--green)}.location-card p{color:var(--muted);white-space:pre-line}.location-card a{color:var(--green);font-weight:800}.facility-list{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}.facility-list span{padding:.35rem .7rem;border:1px solid var(--line);border-radius:99px;font-size:.72rem;color:var(--muted)}.footer{background:#211914;color:white}.footer .site-footer{grid-template-columns:1fr auto auto;border:0;padding:3.5rem 0}.footer-brand{color:white}.footer-logo{display:grid;place-items:center;width:42px;height:42px;padding:4px;border-radius:50%;background:var(--ivory);overflow:hidden}.footer-logo img{display:block;width:auto;max-width:26px;height:auto;max-height:26px;object-fit:contain}.footer-brand img{width:100%;height:100%;object-fit:contain}.site-footer p{margin:.8rem 0 0;color:#a99d96;max-width:330px;font-size:.82rem}.footer-links,.footer-meta{display:grid;align-content:start;gap:.55rem}.footer-links a,.footer-meta a{text-decoration:none}.footer-meta span{color:#a99d96}
@keyframes blink{50%{opacity:0}}@media(max-width:900px){.hero{min-height:auto;grid-template-columns:1fr;padding-top:5rem}.hero-art{min-height:480px}.hero-copy{max-width:700px}.prayer-panel{grid-template-columns:1fr}.prayer-lead{padding:2rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.2)}.community-grid,.give-card,.visit{grid-template-columns:1fr}.give-card{gap:2rem}.footer .site-footer{grid-template-columns:1fr 1fr}.footer-meta{grid-column:1/-1}}
@media(max-width:600px){.hero{padding:4rem 0}.hero-art{min-height:390px}.arch-window{inset:0 0 0 5%;border-radius:200px 200px 18px 18px}.hero-note{bottom:5%}.sun{width:120px;height:120px;right:-10px}.type-line{min-width:0}.schedule{grid-template-columns:repeat(2,1fr)}.schedule>div:nth-child(2n){border-right:0}.jumuah{align-items:flex-start;flex-direction:column;gap:.4rem}.service-card{grid-template-columns:35px 1fr}.service-card i{display:none}.community-filters{width:100%}.community-grid{gap:4rem}.event-card{grid-template-columns:62px 1fr}.give-card{width:100%;padding:2rem 1.3rem}.location-card{grid-template-columns:1fr}.location-number{display:none}.footer .site-footer{grid-template-columns:1fr}.footer-meta{grid-column:auto}.hero-copy>p{font-size:1rem}}
/* A quiet, centered visual language, scoped to the public homepage. */
main,.footer{font-family:"Source Sans 3",sans-serif;text-align:center}
main{background-color:#faf8f0;background-image:var(--pattern);background-size:380px}
main h1,main h2,main h3,.next-name{font-family:Lora,Georgia,serif;font-weight:500;letter-spacing:-.035em;text-align:center}
main h2{font-size:clamp(2rem,4vw,3.1rem);line-height:1.2}
.hero{display:block;min-height:0;padding:6rem 0 5rem}
.hero-copy{max-width:760px;margin:auto}
.hero h1{font-size:clamp(2.5rem,5.2vw,4.6rem);line-height:1.17;margin:0 auto 1.5rem}
.hero-copy>p{margin:1rem auto;max-width:580px;font-size:1.15rem;line-height:1.8}
.hero-copy>.hero-tagline{font-size:1.4rem;color:var(--green);font-family:Lora,Georgia,serif}
.type-line{min-width:5.1em;text-align:left}.hero-actions{justify-content:center}
.hero-art{min-height:0;margin:2.5rem auto 0}.arch-window,.sun{display:none}
.hero-note{position:static;display:grid;gap:.25rem;padding:0;background:transparent;border:0;box-shadow:none}
.hero-note span{font-size:1.8rem}.hero-note small{font-size:.9rem}
.section-head{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1rem;text-align:center;margin-bottom:3rem}
