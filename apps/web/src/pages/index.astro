    const lightTab = resolveLogo(organization?.sameLogoEverywhere ? organization?.logo : organization?.tabLogo) || websiteSource;
    const darkTab = resolveLogo(organization?.sameLogoEverywhere ? organization?.logo : organization?.tabLogoDark) || lightTab;
