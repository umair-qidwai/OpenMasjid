      });
      const facilities=element('div','facility-list');facilities.append(...item.facilities.map((name)=>element('span','',name)));card.append(actions,facilities);
      if(!selected&&content.campuses.length>1){const choose=element('button','button secondary location-select',`Switch campus to ${item.name}`);choose.type='button';choose.dataset.selectCampus=item.id;choose.addEventListener('click',()=>selectCampus(item.id,content));card.append(choose);}
