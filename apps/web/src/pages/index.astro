    text('#today',date);text('#campus-name',activeCampus.name);text('#next-name',timing?prayerNames[timing.nextKey]:'Schedule');text('#prayer-countdown',timing?formatPrayerCountdown(timing.countdownSeconds):'--:--:--');
    ['fajr','sunrise','dhuhr','asr','maghrib','isha'].forEach((key)=>{const adhan=row?.[key]||'Not available';const iqamah=row?.iqamah?.[key]||activeCampus.iqamah[key];text(`[data-prayer="${key}"]`,adhan);if(key!=='sunrise')text(`[data-iqamah="${key}"]`,iqamah);const card=document.querySelector(`[data-prayer-card="${key}"]`);if(card){card.dataset.prayerState=timing?(key===timing.nextKey?'next':key===timing.currentKey?'current':'upcoming'):'upcoming';card.setAttribute('aria-label',key==='sunrise'?`Shuruq, ${adhan}`:`${prayerNames[key]}, Adhan ${adhan}, Iqamah ${iqamah}`)}});
