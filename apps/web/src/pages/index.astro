---
import Base from '../layouts/Base.astro';
import site from '../lib/site.json';
import { getNextPrayer, localDate, localTime, resolveCampusId, campusEvents, campusAnnouncements, safeAssetUrl } from '../lib/site';
const campusId = resolveCampusId(site);
const campus = site.campuses.find((item) => item.id === campusId)!;
const today = localDate(campus.timezone);
const row = campus.timetable.find((item) => item.date === today) ?? campus.timetable[0];
const next = row ? getNextPrayer(row, localTime(campus.timezone)) : null;
const events = campusEvents(site, campusId).slice(0, 3);
const announcements = campusAnnouncements(site, campusId).slice(0, 3);
const basePath = import.meta.env.BASE_URL;
const logoPath = safeAssetUrl(site.organization.logo);
const logoUrl = logoPath ? `${basePath}${logoPath.replace(/^\//, '')}` : `${basePath}assets/logo.svg`;
const prayerKeys = ['fajr','sunrise','dhuhr','asr','maghrib','isha'] as const;
const serviceCards = [
  ['01', 'Prayer & reflection', 'Daily prayers, Jumuah gatherings, and quiet space to reconnect throughout the week.'],
  ['02', 'Learning for life', 'Thoughtful learning for children, young people, families, and curious minds of every age.'],
  ['03', 'Care & connection', 'Practical support, shared meals, and welcoming spaces that help neighbors become community.'],
];
---
<Base title={`${site.organization.name} · ${campus.name}`} description={site.organization.tagline}>
  <header class="container site-header">
    <a class="brand" href={basePath} aria-label={site.organization.name}><img src={logoUrl} alt="" /><span>{site.organization.name}</span></a>
    <nav class="nav" aria-label="Primary"><a href="#prayer">Prayer</a><a href="#programs">Programs</a><a href="#community">Community</a><a href="#visit">Visit</a></nav>
    <a class="button header-action" href={`${basePath}donate/`}>Donate <span aria-hidden="true">↗</span></a>
  </header>

  <main>
    <section class="container hero" aria-labelledby="hero-title">
      <div class="hero-copy reveal">
        <span class="eyebrow">Rooted in faith · Open to all</span>
        <h1 id="hero-title">A place to<br /><span class="type-line" data-words='["belong.","worship.","grow.","gather."]'>belong.</span></h1>
        <p>{site.organization.description}</p>
        <div class="hero-actions"><a class="button" href="#prayer">View prayer times <span aria-hidden="true">↓</span></a><a class="text-link" href="#programs">Explore our community <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="hero-art reveal" style="--delay:120ms" aria-hidden="true">
        <div class="sun"></div><div class="arch-window"><img src={logoUrl} alt="" /></div>
        <div class="hero-note"><span>السلام عليكم</span><small>Peace be upon you</small></div>
      </div>
    </section>

    <section class="prayer-wrap" id="prayer" aria-labelledby="prayer-title">
      <div class="container">
        <div class="section-head light"><div><span class="eyebrow">Daily rhythm</span><h2 id="prayer-title">Prayer times</h2></div><form id="campus-form"><label for="campus">Choose your campus</label><select id="campus" name="campus">{site.campuses.map((item) => <option value={item.id} selected={item.id === campusId}>{item.name}</option>)}</select></form></div>
        <div class="prayer-panel reveal" id="prayer-panel">
          <div class="prayer-lead"><div class="prayer-meta"><span id="campus-name">{campus.name}</span><span id="today">{today}</span></div><p>Next prayer</p><strong class="next-name" id="next-name">{next ? next.key[0].toUpperCase() + next.key.slice(1) : 'Schedule'}</strong><div class="next-row"><b id="next-time">{next?.time ?? '—'}</b><span id="next-iqamah">{next ? `Iqamah ${row?.iqamah?.[next.key] ?? campus.iqamah[next.key]}` : ''}</span></div></div>
          <div class="schedule" id="schedule">{prayerKeys.map((key) => <div><small>{key}</small><b data-prayer={key}>{row?.[key] ?? '—'}</b>{key !== 'sunrise' && <span data-iqamah={key}>Iqamah {row?.iqamah?.[key] ?? campus.iqamah[key]}</span>}</div>)}</div>
          <div id="jumuah" class="jumuah"><strong>Jumuah</strong>{campus.jumuah.map((gathering) => <span>{gathering.label} · {gathering.time}</span>)}</div>
        </div>
        <p class="prayer-disclaimer">Times are for the selected campus. Confirm locally for special days and schedule changes.</p>
      </div>
    </section>

    <section class="container section programs" id="programs" aria-labelledby="programs-title">
      <div class="section-head"><div><span class="eyebrow">More than a building</span><h2 id="programs-title">Programs &amp; services</h2></div><p class="muted">Space to pray, learn, serve, and find your people—whatever season of life you are in.</p></div>
      <div class="service-grid">{serviceCards.map(([number,title,description], index) => <article class="service-card reveal" style={`--delay:${index * 90}ms`}><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div><i aria-hidden="true">↗</i></article>)}</div>
    </section>

    <section class="community-section" id="community">
      <div class="container">
        <div class="section-head"><div><span class="eyebrow">This week in our community</span><h2>Gather. Learn. Connect.</h2></div><div class="community-filters" role="group" aria-label="Filter community content"><button type="button" class="filter active" data-filter="all">All</button><button type="button" class="filter" data-filter="announcement">Announcements</button><button type="button" class="filter" data-filter="event">Events</button></div></div>
        <div id="community-cards" class="community-grid">
          <section class="events-column" data-section-kind="event" aria-labelledby="events-title"><div class="column-title"><span>Calendar</span><h2 id="events-title">Upcoming events</h2></div><div id="event-cards">{events.map((item) => <article class="event-card reveal" data-kind="event"><time datetime={item.startsAt}><b>{new Date(item.startsAt).toLocaleDateString(undefined,{day:'2-digit'})}</b><span>{new Date(item.startsAt).toLocaleDateString(undefined,{month:'short'})}</span></time><div><span class="card-label">{item.category}</span><h3>{item.title}</h3><p>{item.description}</p><small>{item.location}</small></div></article>)}</div></section>
          <section class="news-column" data-section-kind="announcement" aria-labelledby="announcements-title"><div class="column-title"><span>Noticeboard</span><h2 id="announcements-title">Announcements</h2></div><div id="announcement-cards">{announcements.map((item) => <article class="news-card reveal" data-kind="announcement"><span class="card-label">Community note</span><h3>{item.title}</h3><p>{item.body}</p></article>)}</div></section>
        </div>
      </div>
    </section>

    <section class="give-section"><div class="container give-card reveal"><div><span class="eyebrow">Build what lasts</span><h2>Your generosity makes room for everyone.</h2></div><div><p>Support prayer, learning, care, and connection across our community.</p><a class="button gold" href={`${basePath}donate/`}>Make a donation <span aria-hidden="true">↗</span></a></div></div></section>

    <section class="container section visit" id="visit" aria-labelledby="visit-title"><div class="visit-copy"><span class="eyebrow">Our doors are open</span><h2 id="visit-title">Visit us</h2><p>Come for prayer. Stay for community. There is a place for you here.</p><a class="text-link" id="campus-email" href={`mailto:${campus.email}`}>Plan your visit <span aria-hidden="true">→</span></a></div><div class="location-card"><span class="location-number">01</span><div><span class="card-label">Selected campus</span><h3 id="visit-campus">{campus.name}</h3><p id="campus-address">{campus.address}<br />{campus.city}</p><a id="campus-phone" href={`tel:${campus.phone}`}>{campus.phone}</a><div id="facilities" class="facility-list">{campus.facilities.map((facility) => <span>{facility}</span>)}</div></div></div></section>
  </main>

  <footer class="footer"><div class="container site-footer"><div><div class="footer-brand"><img src={logoUrl} alt="" /><span>{site.organization.name}</span></div><p>A welcoming digital doorway for prayer, service, and belonging.</p></div><div class="footer-links"><a href="#prayer">Prayer times</a><a href="#programs">Programs</a><a href="#community">Community</a><a href="#visit">Visit</a></div><div class="footer-meta"><a href={`mailto:${site.organization.email}`}>{site.organization.email}</a><span>© {new Date().getFullYear()} {site.organization.name}</span></div></div></footer>
</Base>

<style>
.hero{min-height:760px;padding:clamp(5rem,10vw,9rem) 0 7rem;display:grid;grid-template-columns:1.06fr .94fr;align-items:center;gap:clamp(2rem,6vw,6rem)}.hero-copy{position:relative;z-index:1}.hero h1{margin:.6rem 0 1.8rem;color:var(--green);max-width:760px}.type-line{display:inline-block;color:var(--gold);min-width:5.8em}.type-line.typing:after{content:"";display:inline-block;width:3px;height:.75em;margin-left:.08em;background:currentColor;animation:blink .8s steps(1) infinite}.hero-copy>p{max-width:540px;font-size:1.08rem;color:var(--muted)}.hero-actions{display:flex;align-items:center;gap:1.5rem;flex-wrap:wrap;margin-top:2rem}.text-link{min-height:44px;display:inline-flex;align-items:center;gap:.5rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}.hero-art{position:relative;min-height:570px}.arch-window{position:absolute;inset:0 0 0 14%;display:grid;place-items:center;border-radius:260px 260px 22px 22px;background:var(--green);overflow:hidden;box-shadow:var(--shadow)}.arch-window:before,.arch-window:after{content:"";position:absolute;border:1px solid rgba(224,193,128,.34);border-radius:50%}.arch-window:before{width:430px;height:430px}.arch-window:after{width:300px;height:300px}.arch-window img{position:relative;z-index:1;width:38%;filter:brightness(0) invert(1);opacity:.92}.sun{position:absolute;z-index:-1;width:190px;height:190px;right:-12%;top:2%;border-radius:50%;background:var(--gold)}.hero-note{position:absolute;z-index:2;left:0;bottom:8%;display:grid;padding:1.1rem 1.4rem;border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.hero-note span{font-family:Georgia,serif;font-size:1.8rem;color:var(--green)}.hero-note small{color:var(--muted)}
.prayer-wrap{padding:clamp(4.5rem,8vw,7rem) 0;background:var(--green);color:white}.section-head.light h2{color:white}.section-head.light .eyebrow{color:#e3bd77}.section-head form{display:grid;gap:.3rem;min-width:min(100%,300px)}.section-head label{font-size:.7rem;text-transform:uppercase;letter-spacing:.14em;color:#c7d6d0;font-weight:800}.section-head select{min-height:48px;padding:.6rem 2.5rem .6rem .8rem;border:1px solid rgba(255,255,255,.24);background:#21493f;color:white;border-radius:5px}.prayer-panel{display:grid;grid-template-columns:1.05fr 1.95fr;border-top:1px solid rgba(255,255,255,.2);border-bottom:1px solid rgba(255,255,255,.2)}.prayer-lead{padding:2rem 2rem 2rem 0;border-right:1px solid rgba(255,255,255,.2)}.prayer-meta{display:flex;justify-content:space-between;gap:1rem;color:#bdd0c9;font-size:.82rem}.prayer-lead>p{margin:3.2rem 0 .1rem;color:#bdd0c9}.next-name{font-size:clamp(2.2rem,5vw,4rem);font-family:"Trebuchet MS",sans-serif}.next-row{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-top:1.2rem}.next-row b{font-size:2rem;color:#e3bd77}.next-row span{font-size:.8rem;color:#bdd0c9}.schedule{display:grid;grid-template-columns:repeat(3,1fr)}.schedule>div{display:grid;align-content:center;gap:.4rem;padding:1.35rem;border-right:1px solid rgba(255,255,255,.13);border-bottom:1px solid rgba(255,255,255,.13)}.schedule small{text-transform:capitalize;color:#bdd0c9}.schedule b{font-size:1.45rem;color:#e3bd77}.schedule span{font-size:.72rem;color:#9eb5ad}.jumuah{grid-column:1/-1;display:flex;gap:1.5rem;align-items:center;padding:1.2rem 0;color:#dfe9e5}.jumuah strong{color:#e3bd77}.prayer-disclaimer{margin:1rem 0 0;color:#9eb5ad;font-size:.78rem}
.programs .section-head p{font-size:1.05rem}.service-grid{border-top:1px solid var(--line)}.service-card{display:grid;grid-template-columns:70px 1fr auto;gap:1.5rem;align-items:center;padding:2rem 0;border-bottom:1px solid var(--line)}.service-card>span{color:var(--gold);font-size:.78rem}.service-card h3{margin-bottom:.45rem;color:var(--green);font-size:clamp(1.45rem,3vw,2.1rem)}.service-card p{margin:0;max-width:650px;color:var(--muted)}.service-card i{display:grid;place-items:center;width:48px;height:48px;border:1px solid var(--line);border-radius:50%;color:var(--green);font-style:normal}
.community-section{padding:clamp(4.5rem,9vw,8rem) 0;background:var(--cream)}.community-filters{display:flex;gap:.4rem;flex-wrap:wrap}.filter{min-height:42px;padding:.5rem .9rem;border:1px solid #cfc1aa;border-radius:99px;background:transparent;color:var(--green);font-weight:750}.filter.active{background:var(--green);color:white;border-color:var(--green)}.community-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2.5rem,7vw,7rem)}.column-title{padding-bottom:1rem;border-bottom:1px solid #cfc1aa}.column-title>span,.card-label{text-transform:uppercase;letter-spacing:.13em;font-size:.68rem;font-weight:850;color:var(--gold)}.column-title h2{font-size:clamp(2rem,4vw,3rem);margin:.25rem 0}.event-card{display:grid;grid-template-columns:80px 1fr;gap:1.2rem;padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.event-card time{display:grid;align-content:start;text-align:center;border-right:1px solid #cfc1aa;color:var(--green)}.event-card time b{font-size:2rem}.event-card time span{text-transform:uppercase;font-size:.7rem}.event-card h3,.news-card h3{margin:.35rem 0 .55rem;color:var(--green)}.event-card p,.news-card p{margin-bottom:.7rem;color:var(--muted)}.event-card small{color:var(--green)}.news-card{padding:1.6rem 0;border-bottom:1px solid #cfc1aa}.news-card:first-child{padding-top:2rem}
.give-section{padding:0 0 clamp(4.5rem,9vw,8rem);background:var(--cream)}.give-card{display:grid;grid-template-columns:1.3fr .7fr;gap:4rem;padding:clamp(2.2rem,6vw,5rem);background:#382820;color:white}.give-card h2{margin:.4rem 0 0;color:#fff}.give-card>div:last-child{align-self:end}.give-card p{color:#d8cbc2}.button.gold{background:var(--gold);border-color:var(--gold);color:#21170f}.visit{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(3rem,8vw,8rem);align-items:center}.visit-copy h2{color:var(--green);margin:.5rem 0 1rem}.visit-copy p{color:var(--muted);max-width:360px}.location-card{display:grid;grid-template-columns:70px 1fr;gap:1.5rem;padding:clamp(1.5rem,4vw,3rem);border:1px solid var(--line);background:var(--paper);box-shadow:var(--shadow)}.location-number{color:var(--gold)}.location-card h3{margin:.5rem 0;font-size:clamp(1.5rem,3vw,2.4rem);color:var(--green)}.location-card p{color:var(--muted);white-space:pre-line}.location-card a{color:var(--green);font-weight:800}.facility-list{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.5rem}.facility-list span{padding:.35rem .7rem;border:1px solid var(--line);border-radius:99px;font-size:.72rem;color:var(--muted)}.footer{background:#211914;color:white}.footer .site-footer{grid-template-columns:1fr auto auto;border:0;padding:3.5rem 0}.footer-brand{color:white}.footer-brand img{filter:brightness(0) invert(1)}.site-footer p{margin:.8rem 0 0;color:#a99d96;max-width:330px;font-size:.82rem}.footer-links,.footer-meta{display:grid;align-content:start;gap:.55rem}.footer-links a,.footer-meta a{text-decoration:none}.footer-meta span{color:#a99d96}
@keyframes blink{50%{opacity:0}}@media(max-width:900px){.hero{min-height:auto;grid-template-columns:1fr;padding-top:5rem}.hero-art{min-height:480px}.hero-copy{max-width:700px}.prayer-panel{grid-template-columns:1fr}.prayer-lead{padding:2rem 0;border-right:0;border-bottom:1px solid rgba(255,255,255,.2)}.community-grid,.give-card,.visit{grid-template-columns:1fr}.give-card{gap:2rem}.footer .site-footer{grid-template-columns:1fr 1fr}.footer-meta{grid-column:1/-1}}
@media(max-width:600px){.hero{padding:4rem 0}.hero-art{min-height:390px}.arch-window{inset:0 0 0 5%;border-radius:200px 200px 18px 18px}.hero-note{bottom:5%}.sun{width:120px;height:120px;right:-10px}.type-line{min-width:0}.schedule{grid-template-columns:repeat(2,1fr)}.schedule>div:nth-child(2n){border-right:0}.jumuah{align-items:flex-start;flex-direction:column;gap:.4rem}.service-card{grid-template-columns:35px 1fr}.service-card i{display:none}.community-filters{width:100%}.community-grid{gap:4rem}.event-card{grid-template-columns:62px 1fr}.give-card{width:100%;padding:2rem 1.3rem}.location-card{grid-template-columns:1fr}.location-number{display:none}.footer .site-footer{grid-template-columns:1fr}.footer-meta{grid-column:auto}.hero-copy>p{font-size:1rem}}
@media(prefers-reduced-motion:reduce){.type-line.typing:after{animation:none}}
</style>

<script define:vars={{ basePath, initialSite: site }}>
  const picker = document.querySelector('#campus');
  const filters = document.querySelectorAll('[data-filter]');
  const text = (selector, value) => { const element = document.querySelector(selector); if (element) element.textContent = value ?? ''; };
  const element = (tag, className, content) => { const node = document.createElement(tag); if (className) node.className = className; if (content !== undefined) node.textContent = content; return node; };
  const formatDate = (value, options) => new Date(value).toLocaleDateString(undefined, options);
  const applyFilter = (kind) => document.querySelectorAll('[data-section-kind]').forEach((section) => { section.hidden = kind !== 'all' && section.dataset.sectionKind !== kind; });
  const renderCommunity = (content, campusId) => {
    const eventRoot = document.querySelector('#event-cards');
    const announcementRoot = document.querySelector('#announcement-cards');
    eventRoot?.replaceChildren(); announcementRoot?.replaceChildren();
    content.events.filter((item) => !item.campusIds.length || item.campusIds.includes(campusId)).slice(0, 3).forEach((item) => {
      const card = element('article', 'event-card reveal'); card.dataset.kind = 'event';
      const time = element('time'); time.dateTime = item.startsAt; time.append(element('b', '', formatDate(item.startsAt, {day:'2-digit'})), element('span', '', formatDate(item.startsAt, {month:'short'})));
      const body = element('div'); body.append(element('span','card-label',item.category),element('h3','',item.title),element('p','',item.description),element('small','',item.location)); card.append(time,body); eventRoot?.append(card);
    });
    const now=Date.now(); content.announcements.filter((item) => (!item.campusIds.length || item.campusIds.includes(campusId)) && Date.parse(item.publishedAt) <= now && (!item.expiresAt || now < Date.parse(item.expiresAt))).forEach((item) => { const card=element('article','news-card reveal'); card.dataset.kind='announcement'; card.append(element('span','card-label','Community note'),element('h3','',item.title),element('p','',item.body)); announcementRoot?.append(card); });
    applyFilter(document.querySelector('[data-filter].active')?.dataset.filter || 'all');
  };
  const renderCampus = (content, campusId) => {
    const campus = content.campuses.find((item) => item.id === campusId) || content.campuses[0]; if (!campus) return;
    const now = new Date();
    const date = new Intl.DateTimeFormat('en-CA',{timeZone:campus.timezone,year:'numeric',month:'2-digit',day:'2-digit'}).format(now);
    const currentTime = new Intl.DateTimeFormat('en-US',{timeZone:campus.timezone,hour:'2-digit',minute:'2-digit',hourCycle:'h23'}).format(now);
    const row = campus.timetable.find((item) => item.date === date) || campus.timetable[0];
    const keys=['fajr','dhuhr','asr','maghrib','isha']; const nextKey=keys.find((key)=>row && row[key]>currentTime)||'fajr';
    text('#today',date); text('#campus-name',campus.name); text('#visit-campus',campus.name); text('#next-name',nextKey[0].toUpperCase()+nextKey.slice(1)); text('#next-time',row?.[nextKey]||'—'); text('#next-iqamah',`Iqamah ${row?.iqamah?.[nextKey]||campus.iqamah[nextKey]}`);
    ['fajr','sunrise','dhuhr','asr','maghrib','isha'].forEach((key)=>{text(`[data-prayer="${key}"]`,row?.[key]||'—');if(key!=='sunrise')text(`[data-iqamah="${key}"]`,`Iqamah ${row?.iqamah?.[key]||campus.iqamah[key]}`)});
    const jumuah=document.querySelector('#jumuah'); if(jumuah){jumuah.replaceChildren(element('strong','','Jumuah'),...campus.jumuah.map((item)=>element('span','',`${item.label} · ${item.time}`)))}
    text('#campus-address',`${campus.address}\n${campus.city}`); const phone=document.querySelector('#campus-phone'); if(phone){phone.textContent=campus.phone;phone.href=`tel:${campus.phone}`}; const email=document.querySelector('#campus-email');if(email)email.href=`mailto:${campus.email}`;
    const facilities=document.querySelector('#facilities');facilities?.replaceChildren(...campus.facilities.map((item)=>element('span','',item))); picker.value=campus.id;renderCommunity(content,campus.id);
  };
  const selectCampus=(campusId,content)=>{const selected=content.campuses.some((item)=>item.id===campusId)?campusId:content.campuses[0]?.id;if(!selected)return;localStorage.setItem('openmasjid-campus',selected);const url=new URL(location.href);url.searchParams.set('campus',selected);history.replaceState({},'',url);renderCampus(content,selected)};
  filters.forEach((button)=>button.addEventListener('click',()=>{filters.forEach((item)=>item.classList.toggle('active',item===button));applyFilter(button.dataset.filter)})); picker?.addEventListener('change',()=>selectCampus(picker.value,window.__openMasjidSite||initialSite));
  const requested=new URLSearchParams(location.search).get('campus');const remembered=localStorage.getItem('openmasjid-campus');fetch(new URL(`${basePath}data/v1/site.json`,location.href),{cache:'no-store'}).then((response)=>{if(!response.ok)throw new Error(String(response.status));return response.json()}).then((content)=>{window.__openMasjidSite=content;selectCampus(requested||remembered||picker?.value,content)}).catch(()=>selectCampus(requested||picker?.value,initialSite));
  const typeLine=document.querySelector('.type-line'); if(typeLine&&!matchMedia('(prefers-reduced-motion: reduce)').matches){const words=JSON.parse(typeLine.dataset.words);let word=0,char=words[0].length,deleting=true;typeLine.classList.add('typing');const tick=()=>{const target=words[word];if(deleting){char-=1;if(char===0){deleting=false;word=(word+1)%words.length;setTimeout(tick,350);return}}else{char+=1;if(char===target.length){deleting=true;typeLine.textContent=target;setTimeout(tick,1500);return}}typeLine.textContent=(deleting?target:words[word]).slice(0,char);setTimeout(tick,deleting?65:105)};setTimeout(tick,1400)}
</script>
