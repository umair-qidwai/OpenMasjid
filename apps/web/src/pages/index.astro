---
import Base from '../layouts/Base.astro';
import site from '../lib/site.json';
import { getNextPrayer, localDate, localTime, resolveCampusId, campusEvents, campusAnnouncements, safeAssetUrl } from '../lib/site';
const campusId = resolveCampusId(site);
const campus = site.campuses.find((item) => item.id === campusId)!;
const today = localDate(campus.timezone);
const row = campus.timetable.find((item) => item.date === today) ?? campus.timetable[0];
const next = row ? getNextPrayer(row, localTime(campus.timezone)) : null;
const events = campusEvents(site, campusId).slice(0, 3);
const announcements = campusAnnouncements(site, campusId).slice(0, 3);
const basePath = import.meta.env.BASE_URL;
---
<Base title={`${site.organization.name} · ${campus.name}`} description={site.organization.tagline}>
  <header class="container site-header">
    <a class="brand" href={basePath}><img src={`${basePath}assets/logo.svg`} alt="" /> <span>{site.organization.name}</span></a>
    <nav class="nav" aria-label="Primary"><a href="#prayer">Prayer</a><a href="#community">Community</a><a href="#visit">Visit</a><a class="button" href={`${basePath}admin/`}>Admin</a></nav>
  </header>
  <main>
    <section class="container hero">
      <div class="hero-copy arch reveal"><span class="eyebrow">A digital doorway to belonging</span><h1>{site.organization.tagline}</h1><p>{site.organization.description}</p><div class="hero-actions"><a class="button" href="#prayer">Today's prayers <span aria-hidden="true">↘</span></a><a class="button secondary" href="#community">Explore the community</a></div></div>
      <div class="hero-mark reveal" aria-label="OpenMasjid architectural mark"><span>م</span></div>
    </section>
    <section class="container section" id="prayer">
      <div class="toolbar"><div><span class="eyebrow">Today · <span id="today">{today}</span></span><h2>The rhythm of the day</h2></div><form id="campus-form"><label for="campus" class="eyebrow">Your campus</label><select id="campus" name="campus" class="campus-picker">{site.campuses.map((item) => <option value={item.id} selected={item.id === campusId}>{item.name}</option>)}</select></form></div>
      <div class="prayer-panel reveal" id="prayer-panel"><div class="prayer-meta"><span id="campus-name">{campus.name}</span><span id="campus-location">{campus.city} · {campus.timezone}</span></div>{next && <div class="prayer-next"><div><div class="next-name" id="next-name">Next · {next.key[0].toUpperCase() + next.key.slice(1)}</div><strong id="next-time">{next.time}</strong></div><span class="eyebrow" id="next-iqamah">Iqamah {row?.iqamah?.[next.key] ?? campus.iqamah[next.key]}</span></div>}<div class="schedule" id="schedule">{(['fajr','sunrise','dhuhr','asr','maghrib','isha'] as const).map((key) => <div><small>{key}</small><b data-prayer={key}>{row?.[key] ?? '—'}</b>{key !== 'sunrise' && <small data-iqamah={key}>Iqamah {row?.iqamah?.[key] ?? campus.iqamah[key]}</small>}</div>)}</div><div id="jumuah" class="jumuah">{campus.jumuah.length > 0 && <><strong>Jumuah</strong>{campus.jumuah.map((gathering) => <span>{gathering.label} · {gathering.time}</span>)}</>}</div></div>
      <p class="muted" style="margin-top:1rem">Times are shown for the selected campus. Please confirm locally for special days and announcements.</p>
    </section>
    <section class="container section" id="community"><div class="section-head"><div><span class="eyebrow">Stay close</span><h2>From our community</h2></div><div class="community-filters" role="group" aria-label="Filter community content"><button type="button" class="button secondary active" data-filter="all">All</button><button type="button" class="button secondary" data-filter="announcement">Announcements</button><button type="button" class="button secondary" data-filter="event">Events</button></div></div><div class="cards" id="community-cards">{announcements.map((item) => <article class="card reveal" data-kind="announcement"><span class="date">Announcement</span><h3>{item.title}</h3><p>{item.body}</p></article>)}{events.map((item) => <article class="card reveal" data-kind="event"><span class="date">{item.category} · {new Date(item.startsAt).toLocaleDateString(undefined,{month:'short',day:'numeric'})}</span><h3>{item.title}</h3><p>{item.description}</p><small>{item.location}</small></article>)}</div></section>
    <section class="container section split" id="visit"><div class="arch"><span class="eyebrow">Come as you are</span><h2>A home for every season of life.</h2><p class="muted">Find your way to <span id="visit-campus">{campus.name}</span>, share a meal, learn, pray, and make a little room for someone new.</p><p><a class="button" id="campus-email" href={`mailto:${campus.email}`}>Get in touch</a></p></div><div><h3>At this campus</h3><div class="facility-list" id="facilities">{campus.facilities.map((facility) => <div>{facility}</div>)}</div><p class="muted" id="campus-address">{campus.address}<br />{campus.city}<br /><a href={`tel:${campus.phone}`}>{campus.phone}</a></p></div></section>
  </main>
  <footer class="container site-footer"><span>© {new Date().getFullYear()} {site.organization.name}</span><span>Built for prayer, community, and calm.</span><a href={`${basePath}admin/`}>Publisher admin</a></footer>
</Base>
<script define:vars={{ basePath, initialSite: site }}>
  const picker = document.querySelector('#campus');
  const filters = document.querySelectorAll('[data-filter]');
  const formatDate = (value) => new Date(value).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  const text = (selector, value) => { const element = document.querySelector(selector); if (element) element.textContent = value ?? ''; };
  const renderCommunity = (content, campusId) => {
    const cards = document.querySelector('#community-cards');
    if (!cards) return;
    cards.replaceChildren();
    const addCard = (kind, title, body, date, location = '') => {
      const article = document.createElement('article'); article.className = 'card reveal'; article.dataset.kind = kind;
      const label = document.createElement('span'); label.className = 'date'; label.textContent = date; article.append(label);
      const heading = document.createElement('h3'); heading.textContent = title; article.append(heading);
      const paragraph = document.createElement('p'); paragraph.textContent = body; article.append(paragraph);
      if (location) { const small = document.createElement('small'); small.textContent = location; article.append(small); }
      cards.append(article);
    };
    content.announcements.filter((item) => !item.campusIds.length || item.campusIds.includes(campusId)).forEach((item) => addCard('announcement', item.title, item.body, 'Announcement'));
    content.events.filter((item) => !item.campusIds.length || item.campusIds.includes(campusId)).slice(0, 3).forEach((item) => addCard('event', item.title, item.description, `${item.category} · ${formatDate(item.startsAt)}`, item.location));
    applyFilter(document.querySelector('[data-filter].active')?.dataset.filter || 'all');
  };
  const applyFilter = (kind) => document.querySelectorAll('#community-cards [data-kind]').forEach((card) => { card.hidden = kind !== 'all' && card.dataset.kind !== kind; });
  const renderCampus = (content, campusId) => {
    const campus = content.campuses.find((item) => item.id === campusId) || content.campuses[0];
    if (!campus) return;
    const now = new Date();
    const date = new Intl.DateTimeFormat('en-CA', { timeZone: campus.timezone, year: 'numeric', month: '2-digit', day: '2-digit' }).format(now);
    const row = campus.timetable.find((item) => item.date === date) || campus.timetable[0];
    const time = new Intl.DateTimeFormat('en-US', { timeZone: campus.timezone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }).format(now);
    const prayerKeys = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
    const nextKey = prayerKeys.find((key) => row && row[key] > time) || 'fajr';
    text('#today', date); text('#campus-name', campus.name); text('#campus-location', `${campus.city} · ${campus.timezone}`); text('#visit-campus', campus.name);
    text('#next-name', `Next · ${nextKey[0].toUpperCase()}${nextKey.slice(1)}`); text('#next-time', row?.[nextKey] || '—'); text('#next-iqamah', `Iqamah ${row?.iqamah?.[nextKey] || campus.iqamah[nextKey]}`);
    ['fajr','sunrise','dhuhr','asr','maghrib','isha'].forEach((key) => { text(`[data-prayer="${key}"]`, row?.[key] || '—'); if (key !== 'sunrise') text(`[data-iqamah="${key}"]`, `Iqamah ${row?.iqamah?.[key] || campus.iqamah[key]}`); });
    const jumuah = document.querySelector('#jumuah'); if (jumuah) { jumuah.replaceChildren(); if (campus.jumuah.length) { const strong = document.createElement('strong'); strong.textContent = 'Jumuah'; jumuah.append(strong, ...campus.jumuah.map((item) => { const span = document.createElement('span'); span.textContent = `${item.label} · ${item.time}`; return span; })); } }
    const facilities = document.querySelector('#facilities'); if (facilities) facilities.replaceChildren(...campus.facilities.map((item) => { const div = document.createElement('div'); div.textContent = item; return div; }));
    text('#campus-address', `${campus.address}\n${campus.city}\n${campus.phone}`); const email = document.querySelector('#campus-email'); if (email) email.href = `mailto:${campus.email}`;
    picker.value = campus.id; renderCommunity(content, campus.id);
  };
  const selectCampus = (campusId, content) => { const valid = content.campuses.some((item) => item.id === campusId); const selected = valid ? campusId : content.campuses[0]?.id; if (!selected) return; localStorage.setItem('openmasjid-campus', selected); const url = new URL(location.href); url.searchParams.set('campus', selected); history.replaceState({}, '', url); renderCampus(content, selected); };
  filters.forEach((button) => button.addEventListener('click', () => { filters.forEach((item) => item.classList.toggle('active', item === button)); applyFilter(button.dataset.filter); }));
  picker?.addEventListener('change', () => selectCampus(picker.value, window.__openMasjidSite || initialSite));
  const requested = new URLSearchParams(location.search).get('campus');
  const remembered = localStorage.getItem('openmasjid-campus');
  fetch(new URL(`${basePath}data/v1/site.json`, location.href), { cache: 'no-store' }).then((response) => { if (!response.ok) throw new Error(`Published content unavailable (${response.status})`); return response.json(); }).then((content) => { window.__openMasjidSite = content; selectCampus(requested || remembered || picker?.value, content); }).catch(() => { selectCampus(requested || picker?.value, initialSite); });
</script>