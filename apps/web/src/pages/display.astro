---
import site from '../lib/site.json';
import { formatPrayerCountdown, getPrayerTiming, localDate, resolveCampusId } from '../lib/site';
const campusId = resolveCampusId(site);
const campus = site.campuses.find((item) => item.id === campusId) ?? site.campuses[0];
const timing = campus ? getPrayerTiming(campus.timetable, campus.timezone) : null;
const row = campus?.timetable.find((item) => item.date === localDate(campus.timezone));
const names = { fajr: 'Fajr', sunrise: 'Shuruq', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha' } as const;
const prayerKeys = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'] as const;
const theme = site.organization.theme;
const displayTime = (value?: string) => {
  const match = value?.match(/^([01]\d|2[0-3]):([0-5]\d)$/);
  if (!match) return value ?? '—';
  const hour = Number(match[1]);
  return `${hour % 12 || 12}:${match[2]} ${hour < 12 ? 'AM' : 'PM'}`;
};
---
<!doctype html>
<html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="theme-color" content={theme.accent} /><title>Prayer display · {site.organization.name}</title><link rel="stylesheet" href={`${import.meta.env.BASE_URL}assets/fonts/fonts.css`} /></head>
<body><main class="display-shell" style={`--display-accent:${theme.accent};--display-background:${theme.background};--pattern:url("${import.meta.env.BASE_URL}assets/mosque-pattern.svg")`}>
<header class="display-title"><p data-campus-name>{campus?.name}</p><h1 data-organization>{site.organization.name}</h1></header>
<section class="display-overview" aria-label="Current time and additional prayer times">
<article class="side-panel sunrise-panel" data-sunrise-panel data-prayer-state="upcoming"><span class="panel-label">Shuruq</span><strong data-prayer="sunrise">{displayTime(row?.sunrise)}</strong></article>
<div class="time-stack"><section class="time-hero" aria-label="Current local time"><time data-display-clock>--:--:--</time><time data-display-date>Loading date</time></section><section class="countdown-panel" aria-label="Next prayer countdown"><span>Next prayer</span><strong data-next-name>{timing ? names[timing.nextKey] : 'Schedule'}</strong><span>in</span><time role="timer" aria-live="off">{timing ? formatPrayerCountdown(timing.countdownSeconds) : '--:--:--'}</time></section></div>
<article class="side-panel jumuah-panel"><span class="panel-label">Jumuah</span><div data-jumuah>{campus?.jumuah.map((item) => <span><small>{item.label}</small><strong>{displayTime(item.time)}</strong></span>)}</div></article>
</section>
<ul class="display-prayers" aria-label="Daily prayer times">{prayerKeys.map((key) => <li aria-label={`${names[key]}, Adhan ${displayTime(row?.[key])}, Iqamah ${displayTime(row?.iqamah?.[key] ?? campus?.iqamah[key])}`} data-prayer-card={key} data-prayer-state={timing?.nextKey === key ? 'next' : timing?.currentKey === key ? 'current' : 'upcoming'}><span class="prayer-name">{names[key]}</span><div class="time-row"><span>Adhan</span><strong data-prayer={key}>{displayTime(row?.[key])}</strong></div><div class="time-row iqamah-row"><span>Iqamah</span><strong data-iqamah={key}>{displayTime(row?.iqamah?.[key] ?? campus?.iqamah[key])}</strong></div></li>)}</ul>
</main></body></html>
<style is:global>
*{box-sizing:border-box}html,body{width:100%;height:100%;margin:0;overflow:hidden}body{min-width:320px;background:#f6f4ed;font-family:"Source Sans 3",system-ui,sans-serif}
.display-shell{--display-accent:#245b4a;--display-background:#eee8dc;--display-warm:color-mix(in srgb,var(--display-accent) 70%,#52675e);position:relative;isolation:isolate;width:100%;height:100dvh;display:grid;grid-template-rows:auto minmax(210px,1fr) auto;gap:clamp(.8rem,1.8vh,1.5rem);padding:clamp(1rem,2vw,2.4rem);overflow:hidden;color:#17382f;background:radial-gradient(ellipse at 50% 0%,#fff,transparent 65%),color-mix(in srgb,var(--display-background) 18%,#f6f4ed);animation:display-enter .45s ease-out}
.display-shell::before{content:"";position:absolute;z-index:-1;inset:0;opacity:1;background:var(--pattern);background-size:280px;filter:contrast(1.6);mask-image:radial-gradient(ellipse at center,rgba(0,0,0,.28) 10%,#000 80%)}
.display-title{text-align:center;min-width:0}.display-title p{margin:0 0 .25rem;color:var(--display-warm);font-size:clamp(.75rem,.95vw,1.1rem);font-weight:600;letter-spacing:.16em;text-transform:uppercase}.display-title h1{margin:0;font:500 clamp(2rem,3.5vw,4.5rem)/1.15 Lora,Georgia,serif;letter-spacing:-.025em;overflow-wrap:anywhere}
.display-overview{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2.15fr) minmax(0,1fr);gap:clamp(.8rem,2vw,2.5rem);min-height:0;align-items:stretch}.side-panel{min-width:0;display:grid;align-content:center;justify-items:center;padding:.5rem;text-align:center;background:transparent;border:0}.panel-label{font-size:clamp(1.6rem,2.7vw,3.4rem);font-weight:600;line-height:1.1}.sunrise-panel>strong{margin-top:1rem;font-size:clamp(2.75rem,5vw,6rem);font-weight:750;line-height:1.1;letter-spacing:-.035em;font-variant-numeric:tabular-nums;white-space:nowrap}.time-period{font-size:.34em;font-weight:600;letter-spacing:.01em;color:var(--display-warm)}
.time-stack{border-radius:2rem;overflow:hidden;border:1px solid #d8dccc;background:rgba(255,255,255,.45);box-shadow:0 16px 48px #17382f0a;min-width:0;display:grid;grid-template-rows:minmax(0,1fr) auto;container-type:inline-size}.time-hero{min-width:0;display:grid;align-content:center;justify-items:center;gap:clamp(.65rem,1.5vh,1.2rem);padding:1rem .7rem;background:transparent;border:0}.time-hero [data-display-clock]{display:flex;align-items:center;justify-content:center;gap:.035em;font-size:clamp(4rem,25cqw,13rem);font-weight:800;line-height:1;letter-spacing:-.045em;font-variant-numeric:tabular-nums;white-space:nowrap}.clock-detail{display:flex;flex-direction:column;align-items:flex-start;gap:.06em;margin-left:.08em;font-size:.36em;line-height:1.05;letter-spacing:0;color:var(--display-warm)}[data-clock-period]{font-size:.8em;font-weight:600}.time-hero [data-display-date]{font-size:clamp(1rem,3.6cqw,2.2rem);font-weight:500;text-align:center;line-height:1.2}.countdown-panel{display:flex;align-items:center;justify-content:center;gap:.5em;min-height:clamp(52px,7vh,82px);padding:.6rem;background:color-mix(in srgb,var(--display-accent) 7%,transparent);border:0;border-top:1px solid #17382f14;font-size:clamp(1.15rem,2.1vw,2.5rem)}.countdown-panel>span:first-child{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%)}.countdown-panel strong,.countdown-panel [role="timer"]{font-weight:700}.countdown-panel [role="timer"]{font-variant-numeric:tabular-nums}
.jumuah-panel [data-jumuah]{width:100%;min-width:0;display:flex;flex-wrap:wrap;justify-content:center;gap:.65rem .8rem;margin-top:1rem}.jumuah-panel [data-jumuah]>span{min-width:0;display:grid;align-content:center;justify-items:center;flex:1 1 40%;gap:.2rem}.jumuah-panel [data-jumuah]>span:first-child{flex-basis:100%}.jumuah-panel small{max-width:100%;font-size:clamp(.65rem,.85vw,1rem);font-weight:600;line-height:1.15;color:var(--display-warm)}.jumuah-panel strong{font-size:clamp(1.7rem,2.6vw,3rem);font-weight:750;line-height:1.4;letter-spacing:-.03em;font-variant-numeric:tabular-nums;white-space:nowrap}.jumuah-panel [data-jumuah]>span:first-child strong{font-size:clamp(2.75rem,4.1vw,5rem)}
.display-prayers{position:relative;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:clamp(.75rem,1.5vw,1.5rem);width:min(100%,1320px);justify-self:center;align-items:start;min-height:0;padding:0;margin:0;list-style:none}.display-prayers li{aspect-ratio:1;min-height:0;min-width:0;display:grid;grid-template-rows:auto 1fr 1fr;padding:clamp(.75rem,1.6vh,1.5rem) .35rem;gap:.3rem;border-radius:clamp(1.3rem,2.3vw,2.5rem);text-align:center;background:rgba(255,255,255,.24);border:1px solid #ded9cb;box-shadow:0 8px 28px #17382f08;-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px)}.display-prayers li[data-prayer-state="next"]{background:color-mix(in srgb,var(--display-accent) 10%,transparent);border-color:var(--display-accent)}.prayer-name{padding:.15rem .25rem;font-size:clamp(1.6rem,2.4vw,3rem);font-weight:600;line-height:1.15}.time-row{display:grid;align-content:center;justify-items:center;gap:.35rem;min-height:0;padding:.35rem 0}.time-row>span{color:var(--display-warm);font-size:clamp(.65rem,.85vw,1rem);font-weight:600;letter-spacing:.14em;text-transform:uppercase}.time-row>strong{font-size:clamp(2.75rem,3.7vw,4.5rem);font-weight:750;line-height:1.05;letter-spacing:-.04em;font-variant-numeric:tabular-nums;white-space:nowrap}
@keyframes display-enter{from{opacity:0}to{opacity:1}}
@media(max-width:900px){html,body{overflow:auto}.display-shell{height:auto;min-height:100dvh;grid-template-rows:auto auto auto;overflow:visible}.display-overview{grid-template-columns:1fr 1fr}.time-stack{grid-column:1/-1;grid-row:1}.time-hero{min-height:220px}.side-panel{min-height:155px}.display-prayers{grid-template-columns:repeat(2,minmax(0,1fr))}.display-prayers li{min-height:280px}.display-prayers li:last-child{grid-column:1/-1}}
@media(max-width:520px){.display-shell{padding:.75rem}.display-title h1{font-size:clamp(2rem,9vw,3rem)}.display-overview{gap:.65rem}.side-panel{padding:.2rem}.panel-label{font-size:1.5rem}.sunrise-panel>strong{font-size:2.75rem}.jumuah-panel [data-jumuah]>span{flex-basis:100%}.jumuah-panel [data-jumuah]>span:first-child strong{font-size:2rem}.jumuah-panel strong{font-size:1.7rem}.display-prayers{grid-template-columns:1fr}.display-prayers li:last-child{grid-column:auto}.display-prayers li{min-height:260px}.countdown-panel{flex-wrap:wrap}}
@media(prefers-reduced-motion:reduce){.display-shell{animation-name:none}}
</style>
<script>
// @ts-nocheck
import { formatPrayerCountdown, getPrayerTiming, localDate, resolveCampusId } from '../lib/site'; import initialSite from '../lib/site.json';
const names = { fajr: 'Fajr', sunrise: 'Shuruq', dhuhr: 'Dhuhr', asr: 'Asr', maghrib: 'Maghrib', isha: 'Isha' }; const prayerKeys = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
let selectedCampus; let content = initialSite; let clockFormatter; let dateFormatter; let wallTimeFormatter; const text = (selector, value) => { const node = document.querySelector(selector); if (node) node.textContent = value ?? ''; };
const displayTime = (value) => { const match = value?.match(/^([01]\d|2[0-3]):([0-5]\d)$/); if (!match) return value ?? '—'; const hour = Number(match[1]); return `${hour % 12 || 12}:${match[2]} ${hour < 12 ? 'AM' : 'PM'}`; };
// Keep the complete text/accessible name while giving digits a clear visual hierarchy.
const renderTime = (node, value) => { if (!node) return; const match = value.match(/^(.*) (AM|PM)$/); if (!match) { node.textContent = value; return; } const period = document.createElement('span'); period.className = 'time-period'; period.textContent = match[2]; node.replaceChildren(document.createTextNode(`${match[1]} `), period); };
const renderClock = (now) => { const node = document.querySelector('[data-display-clock]'); if (!node) return; const value = clockFormatter.format(now); const match = value.match(/^(\d+:\d+)(:\d+)\s(AM|PM)$/); node.setAttribute('aria-label', value); if (!match) { node.textContent = value; return; } const main = document.createElement('span'); main.setAttribute('data-clock-main', ''); main.textContent = match[1]; const detail = document.createElement('span'); detail.className = 'clock-detail'; const seconds = document.createElement('span'); seconds.setAttribute('data-clock-seconds', ''); seconds.textContent = match[2]; const period = document.createElement('span'); period.setAttribute('data-clock-period', ''); period.textContent = match[3]; detail.append(seconds, document.createTextNode(' '), period); node.replaceChildren(main, detail); };
const renderStatic = () => { const requested = new URLSearchParams(location.search).get('campus') ?? undefined; const remembered = localStorage.getItem('openmasjid-campus') ?? undefined; const campusId = resolveCampusId(content, requested, remembered); selectedCampus = content.campuses.find((item) => item.id === campusId) ?? content.campuses[0]; if (!selectedCampus) return; localStorage.setItem('openmasjid-campus', selectedCampus.id); text('[data-organization]', content.organization.name); text('[data-campus-name]', selectedCampus.name); const shell = document.querySelector('.display-shell'); shell?.style.setProperty('--display-accent', content.organization.theme.accent); shell?.style.setProperty('--display-background', content.organization.theme.background); clockFormatter = new Intl.DateTimeFormat('en-US', { timeZone: selectedCampus.timezone, hour: 'numeric', minute: '2-digit', second: '2-digit', hour12: true }); wallTimeFormatter = new Intl.DateTimeFormat('en-US', { timeZone: selectedCampus.timezone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }); dateFormatter = new Intl.DateTimeFormat('en-US', { timeZone: selectedCampus.timezone, weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }); const jumuah = document.querySelector('[data-jumuah]'); if (jumuah) jumuah.replaceChildren(...selectedCampus.jumuah.map((item) => { const entry = document.createElement('span'); const label = document.createElement('small'); const value = document.createElement('strong'); label.textContent = item.label; renderTime(value, displayTime(item.time)); entry.append(label, value); return entry; })); renderLive(); };
const renderLive = () => { if (!selectedCampus) return; const now = new Date(); const timing = getPrayerTiming(selectedCampus.timetable, selectedCampus.timezone, now); renderClock(now); text('[data-display-date]', dateFormatter.format(now)); const row = selectedCampus.timetable.find((item) => item.date === localDate(selectedCampus.timezone, now)); text('[data-next-name]', timing ? names[timing.nextKey] : 'Schedule'); text('[role="timer"]', timing ? formatPrayerCountdown(timing.countdownSeconds) : '--:--:--'); renderTime(document.querySelector('[data-prayer="sunrise"]'), displayTime(row?.sunrise)); const sunrise = document.querySelector('[data-sunrise-panel]'); if (sunrise) sunrise.dataset.prayerState = row && timing?.currentKey === 'fajr' && row.sunrise > wallTimeFormatter.format(now) ? 'next' : 'upcoming'; prayerKeys.forEach((key) => { const adhan = displayTime(row?.[key]); const iqamah = displayTime(row?.iqamah?.[key] ?? selectedCampus.iqamah[key]); renderTime(document.querySelector(`[data-prayer="${key}"]`), adhan); renderTime(document.querySelector(`[data-iqamah="${key}"]`), iqamah); const card = document.querySelector(`[data-prayer-card="${key}"]`); if (card) { card.dataset.prayerState = timing ? (key === timing.nextKey ? 'next' : key === timing.currentKey ? 'current' : 'upcoming') : 'upcoming'; card.setAttribute('aria-label', `${names[key]}, Adhan ${adhan === '—' ? 'not available' : adhan}, Iqamah ${iqamah === '—' ? 'not available' : iqamah}`); } }); };
fetch(new URL(`${import.meta.env.BASE_URL}data/v1/site.json`, location.href), { cache: 'no-store' }).then((response) => { if (!response.ok) throw new Error(String(response.status)); return response.json(); }).then((latest) => { content = latest; renderStatic(); }).catch(renderStatic); setInterval(renderLive, 1000);
</script>
