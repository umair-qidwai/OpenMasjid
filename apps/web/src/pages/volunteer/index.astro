---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
import { resolveAssetUrl, resolveTabLogo } from '../../lib/site';

const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
const tabLogoUrl = resolveTabLogo(site, basePath);
const tabLogoDarkUrl = resolveTabLogo(site, basePath, true);
const opportunities = site.volunteer.mode === 'page' ? site.volunteer.opportunities : [];
---
<Base title={`${site.volunteer.title} · ${site.organization.name}`} description={site.volunteer.description} icon={tabLogoUrl} iconDark={tabLogoDarkUrl}>
  <header class="volunteer-header container">
    <a class="brand" href={basePath} aria-label={`${site.organization.name} home`}><img src={logoUrl} alt="" /><span>{site.organization.name}</span></a>
    <a class="back-link" href={`${basePath}#volunteer`}><span aria-hidden="true">←</span> Back home</a>
  </header>
  <main>
    <section class="volunteer-hero container">
      <span class="section-label">{site.volunteer.title}</span>
      <h1>Find your place<br />to help.</h1>
      <p>{site.volunteer.description}</p>
    </section>
    <section class="opportunities container" aria-labelledby="opportunities-title">
      <div class="opportunities-intro"><span class="section-label">Current opportunities</span><h2 id="opportunities-title">Choose how you would like to contribute.</h2><p>Each button takes you directly to the form chosen by the mosque team.</p></div>
      <div class="opportunity-grid">
        {opportunities.map((opportunity, index) => <article class="opportunity-card">
          <span class="opportunity-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{opportunity.title}</h3>
          <p>{opportunity.description}</p>
          <a class="button opportunity-action" href={opportunity.url}>{opportunity.buttonLabel} <span aria-hidden="true">↗</span></a>
        </article>)}
      </div>
    </section>
  </main>
  <footer class="volunteer-footer"><div class="container"><span>{site.organization.name}</span><a href={`${basePath}#locations`}>Questions? Contact the team</a></div></footer>
</Base>
<style>
.volunteer-header{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1.2rem}.volunteer-header .brand{display:flex;align-items:center;gap:.75rem;min-width:0;color:var(--green);font-weight:800;text-decoration:none}.volunteer-header .brand img{width:46px;height:46px;object-fit:contain}.volunteer-header .brand span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.back-link{display:inline-flex;align-items:center;min-height:44px;gap:.45rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}
main{min-height:calc(100vh - 90px);padding-bottom:clamp(4rem,8vw,7rem);background:#faf8f0;background-image:radial-gradient(circle at 10% 14%,rgba(166,124,67,.08) 0 1px,transparent 2px);background-size:34px 34px}.volunteer-hero{padding-block:clamp(4rem,9vw,8rem);text-align:center}.section-label{display:block;color:var(--gold);font-size:.76rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.volunteer-hero h1{margin:.8rem 0 1.5rem;color:var(--green);font:500 clamp(3.4rem,9vw,7.4rem)/.98 Lora,Georgia,serif;letter-spacing:-.045em}.volunteer-hero p{max-width:720px;margin:auto;color:var(--muted);font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.8}
.opportunities{display:grid;grid-template-columns:minmax(240px,.65fr) minmax(0,1.35fr);gap:clamp(2rem,7vw,6rem);align-items:start}.opportunities-intro{position:sticky;top:110px}.opportunities-intro h2{margin:.7rem 0 1rem;color:var(--green);font:500 clamp(2rem,4vw,3.2rem)/1.12 Lora,Georgia,serif}.opportunities-intro p{color:var(--muted);line-height:1.7}.opportunity-grid{display:grid;gap:1.2rem}.opportunity-card{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:1rem 1.4rem;padding:clamp(1.4rem,3vw,2rem);border:1px solid var(--line);border-radius:24px;background:#fffefa;box-shadow:0 10px 30px rgba(22,75,63,.06)}.opportunity-number{align-self:start;color:var(--gold);font-weight:850}.opportunity-card h3{margin:0;color:var(--green);font:500 clamp(1.45rem,3vw,2rem) Lora,Georgia,serif}.opportunity-card p{grid-column:2;margin:0;color:var(--muted);line-height:1.7}.opportunity-action{grid-column:3;grid-row:1/3;white-space:nowrap;justify-content:center}.volunteer-footer{padding:2rem 0;background:#103a30;color:white}.volunteer-footer .container{display:flex;justify-content:space-between;gap:1rem}.volunteer-footer a{color:white}
@media(max-width:860px){.opportunities{grid-template-columns:1fr}.opportunities-intro{position:static;text-align:center;max-width:650px;margin:auto}.opportunity-card{grid-template-columns:auto minmax(0,1fr)}.opportunity-action{grid-column:2;grid-row:auto;justify-self:start}}
@media(max-width:560px){.volunteer-header .brand span{display:none}.back-link{font-size:.9rem;white-space:nowrap}.volunteer-hero{padding-block:3.5rem}.volunteer-hero h1{font-size:3.2rem}.opportunity-card{grid-template-columns:1fr;text-align:center;padding:1.5rem}.opportunity-number{justify-self:center}.opportunity-card p,.opportunity-action{grid-column:1}.opportunity-action{justify-self:stretch}.volunteer-footer .container{flex-direction:column;align-items:center;text-align:center}}
</style>
