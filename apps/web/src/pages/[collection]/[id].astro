---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
import { resolveAssetUrl, resolveTabLogo } from '../../lib/site';

export function getStaticPaths() {
  return [
    ...site.programs.filter((item) => item.details.enabled).map((item) => ({ params: { collection: 'programs', id: item.id }, props: { item, kind: 'Program' } })),
    ...site.services.filter((item) => item.details.enabled).map((item) => ({ params: { collection: 'services', id: item.id }, props: { item, kind: 'Service' } })),
  ];
}

const { item, kind } = Astro.props;
const { collection } = Astro.params;
const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
const tabLogoUrl = resolveTabLogo(site, basePath);
const tabLogoDarkUrl = resolveTabLogo(site, basePath, true);
const detailImage = item.details.image ? resolveAssetUrl(item.details.image, basePath) : '';
const availableAt = item.campusIds.length ? site.campuses.filter((campus) => item.campusIds.includes(campus.id)) : site.campuses;
const locationLabel = availableAt.length === 1 ? 'Location' : 'Locations';
---
<Base title={`${item.title} · ${site.organization.name}`} description={item.description} icon={tabLogoUrl} iconDark={tabLogoDarkUrl}>
  <header class="detail-header container">
    <a class="brand" href={basePath} aria-label={`${site.organization.name} home`}><img src={logoUrl} alt="" /><span>{site.organization.name}</span></a>
    <a class="back-link" href={`${basePath}#${collection}`}><span aria-hidden="true">←</span> Back to {collection}</a>
  </header>
  <main>
    <section class:list={['detail-hero', 'container', { 'has-image': detailImage }]}>
      <div class="hero-copy">
        <span class="kind">{kind}</span>
        <h1>{item.title}</h1>
        <p>{item.description}</p>
      </div>
      {detailImage && <figure class="detail-media"><img src={detailImage} alt={item.title} /></figure>}
    </section>

    <section class="detail-layout container" aria-label={`${item.title} details`}>
      <article class="detail-body">
        <span class="section-label">About this {kind.toLowerCase()}</span>
        <div class="detail-content">{item.details.content}</div>
      </article>
      <aside class="detail-aside">
        <section class="availability" aria-labelledby="availability-title">
          <span class="section-label">{locationLabel}</span>
          <h2 id="availability-title">Available at</h2>
          <div>{availableAt.map((campus) => <span>{campus.name}</span>)}</div>
        </section>
        <a class="button contact-button" href={`${basePath}#locations`}>Contact the team <span aria-hidden="true">→</span></a>
      </aside>
    </section>
  </main>
  <footer class="detail-footer"><div class="container"><span>{site.organization.name}</span><a href={basePath}>Return home</a></div></footer>
</Base>
<style>
.detail-header{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1.2rem}
.detail-header .brand{display:flex;align-items:center;gap:.75rem;min-width:0;color:var(--green);font-weight:800;text-decoration:none}.detail-header .brand img{width:46px;height:46px;object-fit:contain}.detail-header .brand span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.back-link{display:inline-flex;align-items:center;min-height:44px;gap:.45rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}
main{min-height:calc(100vh - 90px);padding:clamp(2rem,5vw,4.5rem) 0 clamp(4rem,8vw,7rem);background:linear-gradient(180deg,#f3eddf 0,#faf8f3 48%,#f4efe4 100%)}
.detail-hero{display:grid;grid-template-columns:minmax(0,1fr);align-items:center;gap:clamp(2rem,6vw,5rem);padding-block:clamp(3rem,7vw,6.5rem)}.detail-hero.has-image{grid-template-columns:minmax(0,.9fr) minmax(340px,1.1fr)}
.hero-copy{max-width:680px}.kind,.section-label{display:block;color:var(--gold);font-size:.76rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.hero-copy h1{margin:.7rem 0 1.4rem;color:var(--green);font:500 clamp(3rem,7vw,6.4rem)/.98 Lora,Georgia,serif;letter-spacing:-.035em}.hero-copy p{max-width:620px;margin:0;color:var(--muted);font-size:clamp(1.15rem,2vw,1.42rem);line-height:1.7}
.detail-media{position:relative;min-height:clamp(320px,45vw,560px);margin:0;overflow:hidden;border-radius:240px 240px 30px 30px;background:var(--green);box-shadow:var(--shadow)}.detail-media:after{content:"";position:absolute;inset:18px;border:1px solid rgba(255,255,255,.22);border-radius:220px 220px 20px 20px;pointer-events:none}.detail-media img{width:100%;height:100%;min-height:inherit;display:block;object-fit:cover}
.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(260px,340px);gap:clamp(1.5rem,5vw,4rem);align-items:start}.detail-body{padding:clamp(2rem,5vw,4rem);border:1px solid var(--line);border-radius:28px;background:var(--paper);box-shadow:0 20px 60px rgba(48,37,31,.08)}.detail-content{margin-top:1.2rem;color:var(--ink);white-space:pre-line;font-size:1.12rem;line-height:1.95}.detail-aside{position:sticky;top:110px;padding:clamp(1.5rem,4vw,2.4rem);border-radius:26px;background:var(--green);color:white}.availability h2{margin:.45rem 0 1.1rem;color:white;font:500 1.8rem Lora,Georgia,serif}.availability>div{display:grid;gap:.65rem}.availability>div span{padding:.7rem .85rem;border:1px solid rgba(255,255,255,.22);border-radius:12px;background:rgba(255,255,255,.07)}.detail-aside .section-label{color:#d8b875}.contact-button{width:100%;justify-content:center;margin-top:1.6rem;background:var(--gold);border-color:var(--gold);color:#21170f}
.detail-footer{padding:2rem 0;background:#103a30;color:white}.detail-footer .container{display:flex;justify-content:space-between;gap:1rem}.detail-footer a{color:white}
@media(max-width:820px){.detail-hero.has-image,.detail-layout{grid-template-columns:1fr}.detail-media{min-height:380px}.detail-aside{position:static}.hero-copy{text-align:center;margin:auto}.hero-copy p{margin:auto}}
@media(max-width:560px){.detail-header .brand span{display:none}.back-link{font-size:.9rem;white-space:nowrap}.detail-hero{padding-top:2.5rem}.detail-media{min-height:300px;border-radius:170px 170px 24px 24px}.detail-body{padding:1.6rem}.detail-footer .container{flex-direction:column;align-items:center}}
</style>
