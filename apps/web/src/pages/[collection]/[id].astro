---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
import { resolveAssetUrl } from '../../lib/site';

export function getStaticPaths() {
  return [
    ...site.programs.filter((item) => item.details.enabled).map((item) => ({ params: { collection: 'programs', id: item.id }, props: { item, kind: 'Program' } })),
    ...site.services.filter((item) => item.details.enabled).map((item) => ({ params: { collection: 'services', id: item.id }, props: { item, kind: 'Service' } })),
  ];
}

const { item, kind } = Astro.props;
const { collection } = Astro.params;
const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
const availableAt = item.campusIds.length ? site.campuses.filter((campus) => item.campusIds.includes(campus.id)) : site.campuses;
---
<Base title={`${item.title} · ${site.organization.name}`} description={item.description} icon={logoUrl}>
  <header class="detail-header container">
    <a class="brand" href={basePath} aria-label={`${site.organization.name} home`}><img src={logoUrl} alt="" /><span>{site.organization.name}</span></a>
    <a class="button secondary" href={`${basePath}#${collection}`}>Back to {collection}</a>
  </header>
  <main>
    <article class="detail-card container">
      <span class="eyebrow">{kind}</span>
      <h1>{item.title}</h1>
      <p class="summary">{item.description}</p>
      <div class="detail-content">{item.details.content}</div>
      <section class="availability" aria-labelledby="availability-title">
        <h2 id="availability-title">Available at</h2>
        <div>{availableAt.map((campus) => <span>{campus.name}</span>)}</div>
      </section>
      <a class="button" href={`${basePath}#locations`}>Contact us <span aria-hidden="true">→</span></a>
    </article>
  </main>
</Base>
<style>
.detail-header{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-block:1.2rem;border-bottom:1px solid var(--line)}
.detail-header .brand{display:flex;align-items:center;gap:.75rem;color:var(--green);font-weight:800;text-decoration:none;min-width:0}.detail-header .brand img{width:44px;height:44px;object-fit:contain}.detail-header .brand span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
main{min-height:calc(100vh - 90px);padding:clamp(3rem,8vw,7rem) 0;background:radial-gradient(circle at 80% 15%,#eadfc8 0,transparent 28%),var(--ivory)}
.detail-card{max-width:850px;text-align:center}.detail-card h1{margin:.8rem auto 1.5rem;color:var(--green);font-family:Lora,Georgia,serif;font-size:clamp(2.8rem,7vw,5.5rem);font-weight:500}.summary{max-width:680px;margin:0 auto 2.5rem;color:var(--muted);font-size:clamp(1.1rem,2vw,1.3rem)}
.detail-content{padding:clamp(1.8rem,5vw,3.5rem);border:1px solid var(--line);border-radius:24px;background:var(--paper);box-shadow:var(--shadow);white-space:pre-line;text-align:left;font-size:1.08rem;line-height:1.85}
.availability{margin:2.5rem 0}.availability h2{font:500 1.7rem Lora,Georgia,serif;color:var(--green)}.availability div{display:flex;justify-content:center;flex-wrap:wrap;gap:.6rem}.availability span{padding:.45rem .8rem;border:1px solid var(--line);border-radius:999px;background:var(--paper);color:var(--muted)}
@media(max-width:560px){.detail-header .button{padding-inline:.8rem}.detail-header .brand span{max-width:38vw}.detail-content{text-align:left}}
</style>
