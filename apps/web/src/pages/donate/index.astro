---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
import { safeAssetUrl } from '../../lib/site';
const basePath = import.meta.env.BASE_URL;
const logoPath = safeAssetUrl(site.organization.logo);
const logoUrl = logoPath ? `${basePath}${logoPath.replace(/^\//, '')}` : `${basePath}assets/logo.svg`;
---
<Base title={`Give · ${site.organization.name}`} description="Support prayer, learning, care, and community.">
  <header class="container site-header"><a class="brand" href={basePath} aria-label={site.organization.name}><img src={logoUrl} alt="" /><span>{site.organization.name}</span></a><nav class="nav" aria-label="Primary"><a href={`${basePath}#prayer`}>Prayer</a><a href={`${basePath}#programs`}>Programs</a><a href={`${basePath}#community`}>Community</a><a href={`${basePath}#visit`}>Visit</a></nav><a class="button secondary header-action" href={basePath}>Back home</a></header>
  <main class="giving-main">
    <section class="container giving-hero"><div><span class="eyebrow">Support the work</span><h1>Giving,<br /><em>made simple.</em></h1></div><div><p>Every contribution helps create space for worship, learning, care, and connection. Thank you for investing in a community where everyone can belong.</p><div class="trust-note"><span aria-hidden="true">◇</span><small>Your giving supports the selected organization directly.</small></div></div></section>
    <section class="container donation-shell" aria-live="polite"><div class="donation-copy"><span class="eyebrow">Make a contribution</span><h2>Give with purpose.</h2><p>Choose the giving option configured by your mosque. You will always see the destination before continuing.</p></div><div class="donation-panel" id="donation-panel"><div class="empty-state" id="donation-empty"><span aria-hidden="true">✦</span><h3>Online giving is not configured yet.</h3><p>Please contact the organization directly if you would like to contribute.</p><a class="text-link" href={`mailto:${site.organization.email}`}>Contact us <span aria-hidden="true">→</span></a></div></div></section>
  </main>
  <footer class="footer"><div class="container site-footer"><div class="footer-brand"><img src={logoUrl} alt="" /><span>{site.organization.name}</span></div><div class="footer-meta"><a href={`mailto:${site.organization.email}`}>{site.organization.email}</a><span>© {new Date().getFullYear()} {site.organization.name}</span></div></div></footer>
</Base>
<style>
.giving-main{min-height:calc(100vh - 200px)}.giving-hero{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(3rem,9vw,9rem);align-items:end;padding:clamp(5rem,10vw,9rem) 0 clamp(4rem,8vw,7rem)}.giving-hero h1{margin:.6rem 0 0;color:var(--green)}.giving-hero h1 em{color:var(--gold);font-family:Georgia,serif;font-weight:500}.giving-hero>div:last-child>p{font-size:1.1rem;color:var(--muted);max-width:500px}.trust-note{display:flex;align-items:center;gap:.75rem;padding-top:1.2rem;border-top:1px solid var(--line);color:var(--green)}.trust-note span{color:var(--gold);font-size:1.4rem}.donation-shell{display:grid;grid-template-columns:.7fr 1.3fr;gap:clamp(3rem,8vw,8rem);padding-bottom:clamp(5rem,10vw,9rem)}.donation-copy h2{font-size:clamp(2.2rem,4vw,3.4rem);margin:.5rem 0 1rem;color:var(--green)}.donation-copy p{color:var(--muted)}.donation-panel{min-height:370px;display:grid;place-items:center;padding:clamp(1.5rem,4vw,3rem);background:var(--cream);border:1px solid var(--line)}.empty-state{text-align:center;max-width:420px}.empty-state>span{display:grid;place-items:center;width:58px;height:58px;margin:0 auto 1.4rem;border:1px solid var(--gold);border-radius:50%;color:var(--gold)}.empty-state h3{font-size:1.6rem;color:var(--green)}.empty-state p{color:var(--muted)}.text-link{min-height:44px;display:inline-flex;align-items:center;gap:.5rem;color:var(--green);font-weight:800;text-decoration:none;border-bottom:1px solid var(--gold)}.external-give{text-align:center}.external-give h3{font-size:2rem;color:var(--green);margin-bottom:1rem}.external-give p{color:var(--muted);max-width:420px}.donation-frame{width:100%;min-height:540px;border:0;background:white}.footer{background:#211914;color:white}.footer .site-footer{border:0}.footer-brand{color:white}.footer-brand img{filter:brightness(0) invert(1)}.footer-meta{display:grid;gap:.4rem}@media(max-width:820px){.giving-hero,.donation-shell{grid-template-columns:1fr;gap:2.5rem}.giving-hero{align-items:start}.donation-panel{min-height:330px}.donation-frame{min-height:600px}}@media(max-width:520px){.giving-hero{padding-top:4rem}.donation-shell{width:100%;padding-bottom:0}.donation-copy{width:calc(100% - 28px);margin:auto}.donation-panel{border-left:0;border-right:0;padding:1.5rem 1rem}.donation-frame{min-height:650px}}
</style>
<script define:vars={{ basePath }}>
  const panel = document.querySelector('#donation-panel');
  const showExternal = (url) => {
    const wrap=document.createElement('div');wrap.className='external-give';
    const heading=document.createElement('h3');heading.textContent='Continue to secure giving';
    const copy=document.createElement('p');copy.textContent='Your contribution will be completed on the organization’s configured giving partner.';
    const link=document.createElement('a');link.className='button';link.href=url;link.rel='noopener noreferrer';link.textContent='Continue to donation page ↗';wrap.append(heading,copy,link);panel.replaceChildren(wrap);
  };
  const showCustom = (html) => { const frame=document.createElement('iframe');frame.className='donation-frame';frame.title='Donation form';frame.setAttribute('sandbox','');frame.srcdoc=html;panel.replaceChildren(frame); };
  fetch(new URL(`${basePath}data/v1/site.json`,location.href),{cache:'no-store'}).then((response)=>{if(!response.ok)throw new Error(String(response.status));return response.json()}).then((content)=>{const donation=content.donation;if(donation?.mode==='external'&&/^https:\/\//i.test(donation.externalUrl||''))showExternal(donation.externalUrl);else if(donation?.mode==='custom'&&typeof donation.customHtml==='string'&&donation.customHtml.trim())showCustom(donation.customHtml)}).catch(()=>{});
</script>
