---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
const basePath = import.meta.env.BASE_URL;
---
<Base title="Publisher admin · OpenMasjid"><main class="admin-shell"><header class="admin-top"><a class="brand" href={basePath}><img src={`${basePath}assets/logo.svg`} alt="" /> OpenMasjid</a><span class="status-pill" id="save-status">Local draft · not connected</span><a href={basePath} class="button secondary">View site</a></header><section class="admin-intro"><span class="eyebrow">Publisher workspace</span><h1>Shape your community's front door.</h1><p>Content is edited locally until a same-origin publisher is configured. Nothing is saved remotely in demo mode.</p></section><div class="admin-grid"><aside class="admin-nav" aria-label="Admin sections"><button type="button" class="active" data-tab="organization">Organization</button><button type="button" data-tab="giving">Giving</button><button type="button" data-tab="campuses">Campuses & prayer</button><button type="button" data-tab="content">Events & news</button><button type="button" data-tab="tools">Import / export</button></aside><div class="admin-content"><form id="editor" novalidate>
<section class="tab active" data-panel="organization"><div class="panel-heading"><span class="eyebrow">Identity</span><h2>Organization</h2></div><div class="form-grid"><label>Name<input name="organization.name" value={site.organization.name} required /></label><label>Tagline<input name="organization.tagline" value={site.organization.tagline} required /></label><label class="wide">Description<textarea name="organization.description" rows="4">{site.organization.description}</textarea></label><label>Email<input type="email" name="organization.email" value={site.organization.email} /></label><label>Phone<input name="organization.phone" value={site.organization.phone} /></label><label>Website<input type="url" name="organization.website" value={site.organization.website} /></label><label>Logo path<input name="organization.logo" value={site.organization.logo} /></label><label>Accent<input type="color" name="organization.theme.accent" value={site.organization.theme.accent} /></label><label>Background<input type="color" name="organization.theme.background" value={site.organization.theme.background} /></label></div></section>
<section class="tab" data-panel="giving"><div class="panel-heading"><span class="eyebrow">Donations</span><h2>Giving</h2></div><p class="muted">Choose an external HTTPS donation platform, or place simple custom HTML inside an isolated sandbox. Custom scripts are intentionally blocked.</p><div class="form-grid"><label>Donation mode<select name="donation.mode"><option value="none" selected={site.donation.mode === 'none'}>Not configured</option><option value="external" selected={site.donation.mode === 'external'}>External donation platform</option><option value="custom" selected={site.donation.mode === 'custom'}>Custom HTML</option></select></label><label>External donation URL<input type="url" name="donation.externalUrl" value={site.donation.externalUrl ?? ''} placeholder="https://give.example.org/campaign" /></label><label class="wide">Custom HTML<textarea name="donation.customHtml" rows="10" placeholder="Simple HTML form or message; scripts cannot run">{site.donation.customHtml}</textarea></label></div></section>
<section class="tab" data-panel="campuses"><div class="panel-heading"><span class="eyebrow">Prayer settings</span><h2>Campuses</h2></div><div id="campus-editor"></div><button type="button" class="button secondary" id="add-campus">+ Add campus</button></section>
<section class="tab" data-panel="content"><div class="panel-heading"><span class="eyebrow">Community calendar</span><h2>Events & announcements</h2></div><div id="content-editor"></div><div class="button-row"><button type="button" class="button secondary" id="add-event">+ Event</button><button type="button" class="button secondary" id="add-announcement">+ Announcement</button></div></section>
<section class="tab" data-panel="tools"><div class="panel-heading"><span class="eyebrow">Portable content</span><h2>Import & export</h2></div><p class="muted">Download a JSON backup or import one locally. CSV timetable files use <code>date,fajr,sunrise,dhuhr,asr,maghrib,isha</code> and optional iqamah columns.</p><div class="button-row"><button type="button" class="button" id="export-json">Export JSON</button><label class="button secondary file-button">Import JSON<input type="file" id="import-json" accept="application/json" /></label></div><div class="dropzone"><strong>CSV timetable upload</strong><input type="file" id="import-csv" accept=".csv,text/csv" /><small>Invalid or duplicate dates are rejected before anything changes.</small></div></section>
<div class="save-bar"><span id="editor-message">Local draft ready</span><button class="button" type="submit">Save local draft</button><button class="button secondary" type="button" id="publish">Publish</button></div></form></div></div></main></Base>
<style is:global>.admin-shell{width:min(1240px,calc(100% - 36px));margin:auto}.admin-top{display:flex;align-items:center;gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--line)}.admin-top .brand{margin-right:auto}.status-pill{font-size:.8rem;padding:.4rem .7rem;border:1px solid var(--line);border-radius:99px}.admin-intro{padding:4rem 0 3rem;max-width:750px}.admin-intro p{color:#577067}.admin-grid{display:grid;grid-template-columns:210px 1fr;gap:3rem;padding-bottom:5rem}.admin-nav{display:grid;align-content:start;gap:.35rem}.admin-nav button{text-align:left;background:transparent;color:var(--ink);padding:.8rem;border-radius:5px;min-height:44px}.admin-nav button.active{background:var(--ink);color:var(--ivory)}.tab{display:none}.tab.active{display:block}.panel-heading{border-bottom:1px solid var(--line);padding-bottom:1.2rem;margin-bottom:1.5rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem 1.2rem}label{display:grid;gap:.35rem;font-size:.85rem;font-weight:600}.wide{grid-column:1/-1}input,textarea,select{width:100%;background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:.7rem;color:var(--ink);min-height:44px}textarea{resize:vertical}.campus-card,.content-card{border:1px solid var(--line);background:var(--paper);padding:1.2rem;margin-bottom:1rem}.card-head{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1rem}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.button-row{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.5rem 0}.file-button{position:relative;overflow:hidden}.file-button input{position:absolute;inset:0;opacity:0;cursor:pointer}.dropzone{border:1px dashed var(--gold);padding:1.5rem;display:grid;gap:.5rem;margin-top:1rem}.dropzone small{color:var(--muted)}.save-bar{position:static;margin-top:2rem;padding:1rem;background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow);display:flex;align-items:center;gap:.7rem}.save-bar span{margin-right:auto;color:var(--muted);font-size:.85rem}code{background:var(--cream);padding:.15rem .3rem}@media(max-width:760px){.admin-top{flex-wrap:wrap}.admin-top .brand{margin-right:0}.admin-top .status-pill{margin-left:auto;max-width:150px}.admin-top>a.button{display:none}.admin-intro h1{font-size:2.65rem}.admin-grid{grid-template-columns:minmax(0,1fr);gap:1.5rem}.admin-content{min-width:0}.admin-nav{display:flex;max-width:100%;overflow-x:auto}.admin-nav button{flex:0 0 auto;white-space:nowrap}.form-grid,.mini-grid{grid-template-columns:minmax(0,1fr)}.wide{grid-column:auto}.save-bar{flex-wrap:wrap}.save-bar span{width:100%}}
</style>
<script src="../../scripts/admin-client.ts"></script>
