---
import Base from '../../layouts/Base.astro';
import site from '../../lib/site.json';
import { resolveAssetUrl } from '../../lib/site';
const basePath = import.meta.env.BASE_URL;
const logoUrl = resolveAssetUrl(site.organization.logo, basePath);
---
<Base title="Publisher admin · OpenMasjid" icon={logoUrl}><main class="admin-shell"><header class="admin-top"><a class="brand" href={basePath}><img src={logoUrl} alt="" /> OpenMasjid</a><span class="status-pill" id="save-status">Local draft · not connected</span><a href={basePath} class="button secondary">View site</a></header><section class="admin-intro"><span class="eyebrow">Publisher workspace</span><h1>Shape your community's front door.</h1><p>Content is edited locally until a same-origin publisher is configured. Nothing is saved remotely in demo mode.</p></section><div class="admin-grid"><aside class="admin-nav" aria-label="Admin sections"><button type="button" class="active" data-tab="organization">Organization</button><button type="button" data-tab="giving">Giving</button><button type="button" data-tab="campuses">Campuses & prayer</button><button type="button" data-tab="offerings">Programs & services</button><button type="button" data-tab="content">Events & news</button><button type="button" data-tab="tools">Import / export</button></aside><div class="admin-content"><form id="editor" novalidate>
<section class="tab active" data-panel="organization"><div class="panel-heading"><span class="eyebrow">Identity</span><h2>Organization</h2></div><div class="form-grid"><label>Name<input name="organization.name" value={site.organization.name} required /></label><label>Tagline<input name="organization.tagline" value={site.organization.tagline} required /></label><label class="wide">Description<textarea name="organization.description" rows="4">{site.organization.description}</textarea></label><label>Email<input type="email" name="organization.email" value={site.organization.email} /></label><label>Phone<input name="organization.phone" value={site.organization.phone} /></label><label>Website<input type="url" name="organization.website" value={site.organization.website} /></label><div class="wide logo-field"><span class="field-label">Organization logo</span><div class="logo-upload-row"><img id="logo-preview" src={logoUrl} alt="Current organization logo preview" /><div><div class="button-row compact"><label class="button secondary file-button">Choose image<input type="file" id="logo-upload" accept="image/png,image/jpeg,image/webp" /></label><button class="button text-button" type="button" id="cancel-logo-upload" hidden>Cancel selection</button></div><p id="logo-upload-status" class="field-help">PNG, JPEG, or WebP · maximum 2 MiB and 4 megapixels. Images are safely converted to PNG and committed when you publish.</p></div></div><details><summary>Use an existing image URL or asset path instead</summary><label class="field-help">Logo location<input name="organization.logo" value={site.organization.logo} /></label></details></div><label>Accent<input type="color" name="organization.theme.accent" value={site.organization.theme.accent} /></label><label>Background<input type="color" name="organization.theme.background" value={site.organization.theme.background} /></label></div></section>
<section class="tab" data-panel="giving"><div class="panel-heading"><span class="eyebrow">Donations</span><h2>Giving</h2></div><p class="muted">Choose an external HTTPS donation platform, or place simple custom HTML inside an isolated sandbox. Custom scripts are intentionally blocked.</p><div class="form-grid"><label>Donation mode<select name="donation.mode"><option value="none" selected={site.donation.mode === 'none'}>Not configured</option><option value="external" selected={site.donation.mode === 'external'}>External donation platform</option><option value="custom" selected={site.donation.mode === 'custom'}>Custom HTML</option></select></label><label>External donation URL<input type="url" name="donation.externalUrl" value={site.donation.externalUrl ?? ''} placeholder="https://give.example.org/campaign" /></label><label class="wide">Custom HTML<textarea name="donation.customHtml" rows="10" placeholder="Simple HTML form or message; scripts cannot run">{site.donation.customHtml}</textarea></label></div></section>
<section class="tab" data-panel="campuses"><div class="panel-heading"><span class="eyebrow">Prayer settings</span><h2>Campuses</h2></div><div id="campus-editor"></div><button type="button" class="button secondary" id="add-campus">+ Add campus</button></section>
<section class="tab" data-panel="offerings"><div class="panel-heading"><span class="eyebrow">Community offerings</span><h2>Programs &amp; services</h2></div><p class="muted">Programs and services appear in separate homepage sections. Enable a details page only when visitors need more than the card summary.</p><h3>Programs</h3><div id="program-editor"></div><button type="button" class="button secondary" id="add-program">+ Program</button><h3 class="editor-subheading">Services</h3><div id="service-editor"></div><button type="button" class="button secondary" id="add-service">+ Service</button></section>
<section class="tab" data-panel="content"><div class="panel-heading"><span class="eyebrow">Community calendar</span><h2>Events & announcements</h2></div><p class="muted">Choose who sees each update: all campuses, or one or more specific campuses. Dates include a timezone, for example 2026-10-03T18:00:00-04:00.</p><div id="content-editor"></div><div class="button-row"><button type="button" class="button secondary" id="add-event">+ Event</button><button type="button" class="button secondary" id="add-announcement">+ Announcement</button></div></section>
<section class="tab" data-panel="tools"><div class="panel-heading"><span class="eyebrow">Portable content</span><h2>Import & export</h2></div><p class="muted">Download a JSON backup or import one locally. CSV timetable files use <code>date,fajr,sunrise,dhuhr,asr,maghrib,isha</code> and optional iqamah columns.</p><div class="button-row"><button type="button" class="button" id="export-json">Export JSON</button><label class="button secondary file-button">Import JSON<input type="file" id="import-json" accept="application/json" /></label></div><div class="dropzone"><strong>CSV timetable upload</strong><input type="file" id="import-csv" accept=".csv,text/csv" /><small>Invalid or duplicate dates are rejected before anything changes.</small></div></section>
<div class="save-bar"><span id="editor-message" role="status" aria-live="polite">Local draft ready</span><button class="button" type="submit">Save local draft</button><button class="button secondary" type="button" id="publish">Publish</button></div></form></div></div></main></Base>
<style is:global>.admin-shell{width:min(1240px,calc(100% - 36px));margin:auto}.admin-top{display:flex;align-items:center;gap:1rem;padding:1.2rem 0;border-bottom:1px solid var(--line)}.admin-top .brand{margin-right:auto}.status-pill{font-size:.8rem;padding:.4rem .7rem;border:1px solid var(--line);border-radius:99px}.admin-intro{padding:4rem 0 3rem;max-width:750px}.admin-intro p{color:#577067}.admin-grid{display:grid;grid-template-columns:210px 1fr;gap:3rem;padding-bottom:5rem}.admin-nav{display:grid;align-content:start;gap:.35rem}.admin-nav button{text-align:left;background:transparent;color:var(--ink);padding:.8rem;border-radius:5px;min-height:44px}.admin-nav button.active{background:var(--ink);color:var(--ivory)}.tab{display:none}.tab.active{display:block}.panel-heading{border-bottom:1px solid var(--line);padding-bottom:1.2rem;margin-bottom:1.5rem}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem 1.2rem}label{display:grid;gap:.35rem;font-size:.85rem;font-weight:600}.wide{grid-column:1/-1}input,textarea,select{width:100%;background:var(--paper);border:1px solid var(--line);border-radius:3px;padding:.7rem;color:var(--ink);min-height:44px}textarea{resize:vertical}.campus-card,.content-card{border:1px solid var(--line);background:var(--paper);padding:1.2rem;margin-bottom:1rem}.card-head{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:1rem}.mini-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.button-row{display:flex;gap:.7rem;flex-wrap:wrap;margin:1.5rem 0}.file-button{position:relative;overflow:hidden}.file-button input{position:absolute;inset:0;opacity:0;cursor:pointer}.dropzone{border:1px dashed var(--gold);padding:1.5rem;display:grid;gap:.5rem;margin-top:1rem}.dropzone small{color:var(--muted)}.save-bar{position:static;margin-top:2rem;padding:1rem;background:var(--paper);border:1px solid var(--line);box-shadow:var(--shadow);display:flex;align-items:center;gap:.7rem}.save-bar span{margin-right:auto;color:var(--muted);font-size:.85rem}code{background:var(--cream);padding:.15rem .3rem}@media(max-width:760px){.admin-top{flex-wrap:wrap}.admin-top .brand{margin-right:0}.admin-top .status-pill{margin-left:auto;max-width:150px}.admin-top>a.button{display:none}.admin-intro h1{font-size:2.65rem}.admin-grid{grid-template-columns:minmax(0,1fr);gap:1.5rem}.admin-content{min-width:0}.admin-nav{display:flex;max-width:100%;overflow-x:auto}.admin-nav button{flex:0 0 auto;white-space:nowrap}.form-grid,.mini-grid{grid-template-columns:minmax(0,1fr)}.wide{grid-column:auto}.save-bar{flex-wrap:wrap}.save-bar span{width:100%}}
.admin-content{min-width:0}.content-card{display:grid;gap:1rem;border-radius:20px}.campus-card{border-radius:20px}.content-card .card-head{margin:0}.card-head{flex-wrap:wrap}.card-head h3{overflow-wrap:anywhere}.remove-item{min-height:44px;padding:.5rem .8rem;border:1px solid var(--line);border-radius:10px;background:transparent;color:var(--green)}.admin-shell fieldset{min-width:0;border:1px solid var(--line);border-radius:14px;padding:1rem;margin:1rem 0}.admin-shell legend{font-weight:700;padding:0 .4rem}.field-help{font-size:.9rem;color:var(--muted);margin:0 0 .75rem}.audience-options,.campus-choices{display:flex;flex-wrap:wrap;gap:.5rem 1rem}.campus-choices{margin-top:.75rem;border-top:1px solid var(--line);padding-top:.75rem}.campus-choices[hidden]{display:none}.audience-field label{display:flex;align-items:center;gap:.6rem;min-height:44px;cursor:pointer;overflow-wrap:anywhere}.audience-field input{width:20px;height:20px;min-height:20px;padding:0;accent-color:var(--green);flex-shrink:0}.admin-shell input,.admin-shell textarea,.admin-shell select{border-radius:8px;min-width:0}.details-toggle{display:flex;align-items:center;gap:.65rem;min-height:44px}.details-toggle input{width:20px;height:20px;min-height:20px;accent-color:var(--green)}.editor-subheading{margin-top:2.5rem}
.logo-field{display:grid;gap:.6rem}.field-label{font-size:.85rem;font-weight:600}.logo-upload-row{display:flex;align-items:center;gap:1rem;padding:1rem;border:1px solid var(--line);border-radius:14px;background:var(--paper)}.logo-upload-row>img{width:76px;height:76px;object-fit:contain;border:1px solid var(--line);border-radius:16px;background:#fff;padding:.4rem;flex:0 0 auto}.logo-upload-row .field-help{margin:.55rem 0 0}.logo-upload-row .button-row.compact{margin:0;align-items:center}.text-button{min-height:44px;padding:.5rem .7rem;background:transparent;color:var(--green);box-shadow:none}.text-button[hidden]{display:none!important}.logo-field details{padding:.2rem 0}.logo-field summary{color:var(--green);font-size:.85rem;cursor:pointer}.logo-field details label{margin-top:.7rem}@media(max-width:540px){.logo-upload-row{align-items:flex-start}.logo-upload-row>img{width:64px;height:64px}}
</style>
<script src="../../scripts/admin-client.ts"></script>
