---
interface Props { title?: string; description?: string; icon?: string }
const { title = 'OpenMasjid', description = 'A thoughtful digital doorway to community, prayer, and belonging.', icon = `${import.meta.env.BASE_URL}assets/logo.svg` } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#173c34" />
    <title>{title}</title>
    <link rel="icon" href={icon} />
  </head>
  <body><slot /></body>
</html>
<style is:global>
:root{--ivory:#faf8f3;--cream:#f1eadc;--paper:#fffdf8;--ink:#30251f;--green:#173c34;--green-soft:#2f5e51;--gold:#b38a4b;--line:#ded4c3;--muted:#71675f;--shadow:0 24px 70px rgba(48,37,31,.11);--radius:28px}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:110px}body{margin:0;min-width:320px;background:var(--ivory);color:var(--ink);font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6;overflow-x:hidden}h1,h2,h3,p{margin-top:0}h1,h2,h3{font-family:"Trebuchet MS",Avenir,ui-sans-serif,system-ui,sans-serif;line-height:1.02;font-weight:700;letter-spacing:-.045em}h1{font-size:clamp(3.15rem,8vw,7.4rem)}h2{font-size:clamp(2.25rem,5vw,4.5rem)}h3{font-size:1.35rem;letter-spacing:-.025em}a{color:inherit}button,select,input,textarea{font:inherit}button,a,input,select,textarea{outline-offset:4px}:focus-visible{outline:3px solid var(--gold)}button{cursor:pointer}.container{width:min(1180px,calc(100% - 40px));margin-inline:auto}.eyebrow{display:inline-flex;align-items:center;gap:.55rem;text-transform:uppercase;letter-spacing:.17em;font-size:.72rem;font-weight:800;color:var(--gold)}.eyebrow:before{content:"";width:24px;height:1px;background:currentColor}.muted{color:var(--muted)}.button{min-height:46px;display:inline-flex;align-items:center;justify-content:center;gap:.55rem;padding:.72rem 1.2rem;border:1px solid var(--green);border-radius:999px;background:var(--green);color:#fff;text-decoration:none;font-weight:750;transition:transform .2s ease,background .2s ease,color .2s ease}.button:hover{transform:translateY(-2px);background:var(--green-soft)}.button.secondary{background:transparent;color:var(--green);border-color:var(--line)}.button.secondary:hover{background:var(--cream)}.site-header{position:sticky;top:14px;z-index:20;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:1rem;margin-top:14px;padding:.62rem .72rem .62rem 1rem;background:rgba(255,253,248,.9);border:1px solid rgba(222,212,195,.86);border-radius:999px;box-shadow:0 12px 40px rgba(48,37,31,.08);backdrop-filter:blur(16px)}.brand{display:flex;align-items:center;min-width:0;gap:.65rem;text-decoration:none;font-weight:800;letter-spacing:-.02em}.brand img{width:42px;height:42px;flex:0 0 auto}.brand span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.nav{display:flex;align-items:center;justify-content:center;gap:1.4rem}.nav a{min-height:44px;display:flex;align-items:center;text-decoration:none;font-size:.86rem;font-weight:700}.nav a:not(.button):hover{color:var(--green-soft)}.header-action{justify-self:end}.section{padding:clamp(4.5rem,9vw,8rem) 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:2.2rem}.section-head p{max-width:34rem;margin-bottom:.4rem}.site-footer{display:grid;grid-template-columns:1fr auto;gap:2rem;padding:2.2rem 0 3rem;border-top:1px solid var(--line);font-size:.85rem;color:var(--muted)}.footer-brand{display:flex;align-items:center;gap:.65rem;color:var(--ink);font-weight:800}.footer-brand img{width:34px;height:34px}.footer-meta{text-align:right}.reveal{animation:rise .7s cubic-bezier(.2,.75,.25,1) both;animation-delay:var(--delay,0ms)}@keyframes rise{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:none}}@media(max-width:850px){.site-header{grid-template-columns:1fr auto}.nav{display:none}.header-action{display:flex}.section-head{align-items:start;flex-direction:column}.site-footer{grid-template-columns:1fr}.footer-meta{text-align:left}}@media(max-width:520px){.container{width:min(100% - 28px,1180px)}.site-header{top:8px;margin-top:8px;padding:.5rem .5rem .5rem .7rem}.brand img{width:36px;height:36px}.brand span{font-size:.9rem}.header-action{padding:.6rem .9rem;min-height:42px}.section{padding:4.2rem 0}h1{font-size:clamp(3rem,16vw,4.6rem)}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal,.button{animation:none!important;transition:none!important}}
</style>