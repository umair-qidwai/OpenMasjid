---
interface Props { title?: string; description?: string }
const { title = 'OpenMasjid', description = 'A calmer digital doorway to community, prayer, and belonging.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><title>{title}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}assets/logo.svg`} />
  </head>
  <body><slot /></body>
</html>
<style is:global>
:root{--ivory:#f6f3ec;--ink:#183c34;--brass:#a67c43;--line:#d9d0bf;--paper:#fbfaf6;--shadow:0 20px 60px #183c3417}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--ivory);color:var(--ink);font-family:'DM Sans',system-ui,sans-serif;line-height:1.55}h1,h2,h3{font-family:Georgia,'Times New Roman',serif;line-height:1.05;font-weight:600;margin:0}h1{font-size:clamp(2.8rem,7vw,6.8rem);letter-spacing:-.055em}h2{font-size:clamp(2rem,4vw,3.8rem);letter-spacing:-.04em}h3{font-size:1.35rem}a{color:inherit}button,select,input,textarea{font:inherit}button,a,.tap{min-height:44px}button{cursor:pointer;border:0}.container{width:min(1180px,calc(100% - 40px));margin:auto}.eyebrow{text-transform:uppercase;letter-spacing:.16em;font-size:.72rem;font-weight:600;color:var(--brass)}.muted{color:#577067}.arch{position:relative}.arch:before{content:'';position:absolute;inset:-26px auto auto -26px;width:110px;height:150px;border:1px solid #a67c4360;border-bottom:0;border-radius:60px 60px 0 0;pointer-events:none}.button{display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.72rem 1.15rem;background:var(--ink);color:var(--ivory);border-radius:999px;text-decoration:none;font-weight:600}.button.secondary{background:transparent;color:var(--ink);border:1px solid var(--line)}.site-header{display:flex;align-items:center;justify-content:space-between;padding:1.2rem 0}.brand{display:flex;align-items:center;gap:.65rem;text-decoration:none;font-family:'Playfair Display',serif;font-size:1.25rem}.brand img{width:38px;height:38px}.nav{display:flex;align-items:center;gap:1.3rem;font-size:.9rem}.hero{padding:clamp(3rem,9vw,8rem) 0 5rem;display:grid;grid-template-columns:1.1fr .9fr;gap:4rem;align-items:center}.hero-copy p{font-size:1.15rem;max-width:32rem;color:#577067;margin:1.5rem 0 2rem}.hero-actions{display:flex;gap:.75rem;flex-wrap:wrap}.hero-mark{min-height:400px;display:grid;place-items:center;background:var(--ink);border-radius:220px 220px 0 0;position:relative;overflow:hidden;box-shadow:var(--shadow)}.hero-mark:after{content:'';position:absolute;width:72%;height:72%;border:1px solid #d9c39b55;border-radius:180px 180px 0 0}.hero-mark span{font-family:'Playfair Display';font-size:8rem;color:#d9c39b;z-index:1}.toolbar{display:flex;justify-content:space-between;align-items:end;gap:1rem;margin:1rem 0 1.5rem}.campus-picker{background:transparent;border:0;border-bottom:1px solid var(--brass);padding:.45rem 2rem .45rem 0;color:var(--ink);font-weight:600}.prayer-panel{background:var(--ink);color:var(--ivory);padding:2rem;border-radius:3px;position:relative;overflow:hidden}.prayer-panel:after{content:'';position:absolute;right:-5%;bottom:-45%;width:50%;aspect-ratio:1;border:1px solid #d9c39b44;border-radius:50%}.prayer-meta{display:flex;justify-content:space-between;gap:1rem;color:#c7d3cb}.prayer-next{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin:1rem 0 1.7rem}.prayer-next strong{font-family:'Playfair Display';font-size:clamp(3rem,8vw,6rem);line-height:.9;color:#d9c39b}.prayer-next .next-name{font-size:1.3rem}.schedule{display:grid;grid-template-columns:repeat(6,1fr);border-top:1px solid #ffffff2e}.schedule div{padding:1rem .5rem;border-right:1px solid #ffffff20}.schedule div:last-child{border:0}.schedule b{display:block;color:#d9c39b;font-size:1.1rem}.section{padding:6rem 0}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:2rem}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.card{background:var(--paper);padding:1.5rem;border:1px solid var(--line);min-height:210px;box-shadow:0 10px 30px #183c3408}.card .date{color:var(--brass);font-size:.75rem;text-transform:uppercase;letter-spacing:.12em}.card p{color:#577067}.split{display:grid;grid-template-columns:1fr 1fr;gap:4rem;align-items:start}.facility-list{display:grid;grid-template-columns:1fr 1fr;gap:0;border-top:1px solid var(--line)}.facility-list div{padding:1rem 0;border-bottom:1px solid var(--line)}.site-footer{border-top:1px solid var(--line);padding:2rem 0;display:flex;justify-content:space-between;gap:1rem;color:#577067}.reveal{animation:reveal .7s ease both;animation-timeline:view();animation-range:entry 0% cover 25%}@keyframes reveal{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}@media(max-width:760px){.container{width:min(100% - 28px,1180px)}.nav a:not(.button){display:none}.hero{grid-template-columns:1fr;padding-top:3.5rem;gap:2rem}.hero-mark{min-height:260px}.hero-mark span{font-size:5rem}.toolbar,.section-head{display:block}.toolbar>*{margin-bottom:1rem}.schedule{grid-template-columns:repeat(3,1fr)}.schedule div:nth-child(3){border-right:0}.cards,.split{grid-template-columns:1fr}.section{padding:4rem 0}.site-footer{display:block}.site-footer>*{display:block;margin:.5rem 0}.arch:before{left:-10px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.reveal{animation:none}}
</style>
